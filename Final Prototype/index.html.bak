<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
<title>Mahjong × Block</title>
<style>
:root{
  --wood:#2b1d16; --wood2:#3d2a20; --panel:#33210f; --panel2:#170f07;
  --cream:#f6ecd8; --cream2:#e6d7ba; --ink:#2a2018;
  --gold:#e8b64c; --jade:#8fbf52; --amber:#d9a441; --danger:#ff5d51; --blue:#4a9fe0; --red:#e0553f; --green:#3fae6a;
  --bamboo:#a7b85a; --bamboo2:#7c8a3e; --bamboo3:#4d5a24;
  --cell:34px;
  --felt:#14342b; --felt2:#0d241d;
}
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;height:100%;}
body{
  background:
    repeating-linear-gradient(90deg, rgba(0,0,0,.07) 0 2px, transparent 2px 9px, rgba(255,255,255,.03) 9px 10px, transparent 10px 19px),
    repeating-linear-gradient(4deg, rgba(0,0,0,.05) 0 3px, transparent 3px 30px),
    radial-gradient(120% 80% at 50% -10%, #5a3d2c 0%, var(--wood) 55%, #1b120d 100%);
  color:var(--cream); font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  overscroll-behavior:none; touch-action:manipulation; user-select:none;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  min-height:100%; padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
}
#screen-game{width:100%; max-width:440px; display:flex; flex-direction:column; gap:7px; padding:8px 10px 12px; margin:auto 0;}

/* ---------- HUD ---------- */
#hud{display:flex; align-items:center; gap:8px;}
.hud-box{flex:1; background:rgba(0,0,0,.28); border:1px solid rgba(232,182,76,.22); border-radius:10px; padding:5px 8px;}
.hud-lab{font-size:14px; letter-spacing:.08em; text-transform:uppercase; opacity:.68;}
.hud-val{font-size:16px; font-weight:800; font-variant-numeric:tabular-nums; line-height:1.15;}
.hud-val small{font-size:11px; font-weight:600; opacity:.6;}
#h-gl{font-size:23px;}
#h-gl small{font-size:14px; font-weight:700; opacity:.65;}
#goalbar{height:4px; background:rgba(255,255,255,.12); border-radius:3px; margin-top:3px; overflow:hidden;}
#goalfill{height:100%; width:0%; background:linear-gradient(90deg,var(--jade),var(--gold)); transition:width .3s;}
.hud-box-goal{flex:1.4; background:rgba(232,182,76,.16); border:1px solid rgba(232,182,76,.65);
  box-shadow:0 0 14px rgba(232,182,76,.3), inset 0 1px 0 rgba(255,255,255,.1);}
.hud-box-goal .hud-lab{color:var(--gold); opacity:1; font-weight:700;}
.hud-box-goal #h-gl{font-size:29px;}
.hud-box-seal{flex:.8; text-align:center; background:rgba(0,0,0,.24);}
.hud-box-seal .hud-lab{font-size:16px; opacity:.85;}
.hud-box-seal .hud-val{font-size:14px;}
.hud-box-goal #goalbar{height:6px; margin-top:4px;}
#btn-help{width:48px;height:48px;flex:none;border-radius:10px;background:rgba(0,0,0,.28);border:1px solid rgba(232,182,76,.22);color:var(--cream);font-size:18px;font-weight:700;}

/* ---------- KHAY ---------- */
#khay-wrap{
  background:linear-gradient(180deg,#432e22,#2e2018);
  border:1px solid rgba(232,182,76,.3); border-radius:14px; padding:7px 8px 8px;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.07), 0 4px 14px rgba(0,0,0,.4);
  position:relative; transition:box-shadow .2s, border-color .2s;
}
#khay-wrap.warn{border-color:rgba(255,93,81,.65); box-shadow:inset 0 1px 0 rgba(255,255,255,.07), 0 0 20px rgba(255,93,81,.35);}
#khay-wrap.warn #khay-title b{color:var(--danger);}
#khay-wrap.shake{animation:shake .34s;}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-5px)}40%{transform:translateX(5px)}60%{transform:translateX(-3px)}80%{transform:translateX(3px)}}
#khay-title{display:flex; align-items:baseline; gap:6px; font-size:10px; letter-spacing:.14em; text-transform:uppercase; opacity:.75; margin-bottom:5px;}
#khay-title b{font-size:11px; letter-spacing:0; opacity:1; color:var(--gold);}
#forecast{display:block; text-align:center; font-size:14px; letter-spacing:0; text-transform:none; font-weight:700; opacity:0; transition:opacity .12s; min-height:18px; margin-bottom:4px; color:var(--gold);}
#forecast.on{opacity:1;}
#forecast.bad{color:var(--danger);}
#forecast.ok{color:var(--jade);}
#khay{display:flex; gap:4px; justify-content:center;}
.slot{
  flex:1 1 0; max-width:46px; aspect-ratio:.78; border-radius:7px;
  background:rgba(0,0,0,.32); border:1px dashed rgba(246,236,216,.16);
  display:flex; align-items:center; justify-content:center; position:relative;
}
.slot.filled{border-style:solid; border-color:transparent; background:transparent;}
.slot.last{border-color:rgba(255,93,81,.5); background:rgba(255,93,81,.08);}
.slot .tile{width:100%; height:100%;}
.slot .ghostres{opacity:.34; filter:grayscale(.3);}
.slot.popping{animation:popslot .38s ease-out;}
@keyframes popslot{0%{transform:scale(1)}35%{transform:scale(1.3); filter:brightness(1.9)}100%{transform:scale(0); opacity:0}}
.slot.popping.big{animation:popslotbig .46s ease-out;}
@keyframes popslotbig{0%{transform:scale(1)}35%{transform:scale(1.6); filter:brightness(2.5)}100%{transform:scale(0); opacity:0}}

/* ---------- BOARD ---------- */
#board-wrap{position:relative; width:100%; display:flex; justify-content:center;}
#board{
  width:min(100%, 62vh); flex:none;
  display:grid; gap:3px; padding:6px; border-radius:14px;
  background:linear-gradient(160deg,var(--panel),var(--panel2));
  border:1px solid rgba(232,182,76,.22);
  box-shadow:inset 0 2px 10px rgba(0,0,0,.5), 0 6px 18px rgba(0,0,0,.35);
}
.cell{aspect-ratio:1; border-radius:6px; background:rgba(0,0,0,.22); box-shadow:inset 0 0 0 1px rgba(255,255,255,.035); position:relative;}
.cell.ghost{background:rgba(232,182,76,.2); box-shadow:inset 0 0 0 2px rgba(232,182,76,.75);}
.cell.ghostbad{background:rgba(255,93,81,.2); box-shadow:inset 0 0 0 2px rgba(255,93,81,.8);}
.cell.lineon::after,.cell.linebad::after{content:''; position:absolute; inset:0; border-radius:6px; pointer-events:none; z-index:3;}
.cell.lineon::after{box-shadow:inset 0 0 0 2px rgba(143,191,82,.95); background:rgba(143,191,82,.26);}
.cell.linebad::after{box-shadow:inset 0 0 0 2px rgba(255,93,81,1); background:rgba(255,93,81,.34);}
.cell.flash{animation:flash .22s ease-out;}
@keyframes flash{0%{filter:brightness(1)}45%{filter:brightness(2.6)}100%{filter:brightness(1)}}
.cell .tile{position:absolute; inset:0;}
.cell .tile.drop{animation:drop .19s cubic-bezier(.3,1.5,.5,1);}
@keyframes drop{0%{transform:scale(.55) translateY(-8px); opacity:.3}100%{transform:scale(1) translateY(0); opacity:1}}

/* ---------- Ô ẤN / CELL MỤC TIÊU ---------- */
.cell.target{
  background:linear-gradient(145deg,rgba(91,52,34,.96),rgba(35,22,17,.98));
  box-shadow:inset 0 0 0 2px rgba(232,182,76,.58), inset 0 0 14px rgba(0,0,0,.75);
  overflow:hidden;
}
.cell.target .tile.seal-tile{inset:5px; opacity:.54; filter:saturate(.68) brightness(.83); z-index:1;}
.cell.target .sealmark{
  position:absolute; inset:0; z-index:3; display:flex; align-items:center; justify-content:center;
  color:var(--gold); font-size:19px; font-weight:900; text-shadow:0 2px 5px #000;
  background:repeating-linear-gradient(45deg,transparent 0 7px,rgba(232,182,76,.13) 7px 9px);
  pointer-events:none;
}
.cell.target .sealhp{
  position:absolute; right:2px; top:2px; z-index:5; min-width:17px; height:17px; padding:0 4px;
  display:flex; align-items:center; justify-content:center; border-radius:9px;
  background:var(--danger); color:#fff; border:1px solid rgba(255,255,255,.65);
  font-size:10px; line-height:1; font-weight:900; box-shadow:0 1px 4px rgba(0,0,0,.6);
}
.cell.targetsoon{box-shadow:inset 0 0 0 3px var(--jade),0 0 14px rgba(143,191,82,.65)!important;}
.cell.targethit{animation:targethit .38s ease-out;}
@keyframes targethit{0%{filter:brightness(1)}35%{filter:brightness(3);transform:scale(1.08)}100%{filter:brightness(1);transform:scale(1)}}
.cell.breakflash{animation:breakflash .48s ease-out;}
@keyframes breakflash{0%{background:rgba(232,182,76,.9);transform:scale(1.08)}100%{background:rgba(0,0,0,.22);transform:scale(1)}}
.ghosttile{opacity:.5;}

/* ---------- TILE ART (ảnh thật, cắt từ Assets/Mahjong.png) ----------
 * Không còn badge số hạng (.rk) — mặt tile thật đã đủ để phân biệt (số chấm/
 * sách/hình gió-rồng-hoa), không cần thêm số đè lên nữa. */
.tile{border-radius:6px; display:flex; align-items:center; justify-content:center; overflow:hidden; position:relative;
  background:linear-gradient(155deg,var(--cream),var(--cream2));
  box-shadow:inset 0 1px 0 rgba(255,255,255,.6), inset 0 -3px 3px rgba(0,0,0,.16),
    2px 3px 0 0 var(--bamboo2), 2px 3px 0 1px var(--bamboo3), 3px 5px 7px 0 rgba(0,0,0,.45);}
.tile img{width:100%; height:100%; object-fit:contain; display:block; pointer-events:none; position:relative; z-index:1;}

/* ---------- TRAY ---------- */
#tray-wrap{background:rgba(0,0,0,.24); border:1px solid rgba(232,182,76,.18); border-radius:14px; padding:8px;}
#tray{display:flex; gap:6px; align-items:center; justify-content:space-around; min-height:74px;}
.piece{flex:1; display:flex; align-items:center; justify-content:center; padding:5px 2px; border-radius:10px; position:relative; transition:transform .12s, background .12s;}
.piece.sel{background:rgba(232,182,76,.15); box-shadow:inset 0 0 0 2px rgba(232,182,76,.6); transform:translateY(-3px);}
.piece.used{opacity:.16; pointer-events:none;}
.pgrid{display:grid; gap:2px;}
.pgrid .tile{width:26px; height:32px;}
#tools{display:flex; gap:6px; margin-top:7px;}
.tool{flex:1; padding:8px 4px; border-radius:10px; border:1px solid rgba(232,182,76,.28); background:rgba(0,0,0,.3);
  color:var(--cream); font-size:11.5px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:5px;}
.tool:disabled{opacity:.3;}
.tool.armed{background:rgba(255,93,81,.22); border-color:var(--danger); color:#ffd9d5;}
.tool b{color:var(--gold); font-variant-numeric:tabular-nums;}

/* ---------- FLOATING ---------- */
.fly{position:fixed; z-index:60; pointer-events:none;}
#dragghost{position:fixed; z-index:70; pointer-events:none; opacity:.92; filter:drop-shadow(0 6px 10px rgba(0,0,0,.5));}
#dragghost .pgrid{gap:3px;}
.float{position:fixed; z-index:80; pointer-events:none; font-weight:900; font-size:17px; color:var(--gold);
  text-shadow:0 2px 6px rgba(0,0,0,.8); animation:floatup 1s ease-out forwards;}
@keyframes floatup{0%{transform:translate(-50%,0) scale(.7); opacity:0}25%{transform:translate(-50%,-12px) scale(1.15); opacity:1}100%{transform:translate(-50%,-46px) scale(1); opacity:0}}
.spark{position:fixed; z-index:75; width:6px; height:6px; border-radius:50%; pointer-events:none;}
.shard{position:fixed; z-index:76; width:7px; height:9px; border-radius:2px; pointer-events:none; box-shadow:0 1px 3px rgba(0,0,0,.4);}

/* ---------- OVERLAY ---------- */
#ov{position:fixed; inset:0; z-index:100; background:rgba(12,8,6,.86); backdrop-filter:blur(3px);
  display:none; align-items:center; justify-content:center; padding:18px;}
#ov.on{display:flex;}
#ovcard{width:100%; max-width:360px; background:linear-gradient(170deg,#3d2a20,#241812); border:1px solid rgba(232,182,76,.35);
  border-radius:16px; padding:18px; box-shadow:0 20px 50px rgba(0,0,0,.6); max-height:86vh; overflow:auto;}
#ovcard h2{margin:0 0 4px; font-size:20px; color:var(--gold);}
#ovcard .sub{font-size:14px; opacity:.7; margin-bottom:12px;}
#ovcard p{font-size:15px; line-height:1.55; margin:0 0 9px;}
#ovcard ul{font-size:14px; line-height:1.6; padding-left:17px; margin:0 0 10px;}
#ovcard .hl{color:var(--gold); font-weight:700;}
#ovcard .dg{color:var(--danger); font-weight:700;}
.btn{width:100%; padding:15px; border-radius:11px; border:0; font-size:17px; font-weight:800;
  background:linear-gradient(180deg,var(--gold),#c8912e); color:#2a1d0b; margin-top:6px;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.45), inset 0 -2px 3px rgba(0,0,0,.22), 0 3px 0 0 #8a611c, 0 5px 8px rgba(0,0,0,.4);}
.btn.ghost{background:rgba(255,255,255,.09); color:var(--cream); border:1px solid rgba(255,255,255,.16);}
.demo{display:flex; gap:4px; justify-content:center; margin:8px 0 12px;}
.demo .tile{width:30px;height:38px;}
.demo .arw{align-self:center; opacity:.6; font-size:16px; padding:0 3px;}
#toast{position:absolute; left:50%; bottom:10px; transform:translateX(-50%); z-index:90; background:rgba(20,14,10,.95);
  border:1px solid rgba(232,182,76,.4); color:var(--cream); padding:9px 14px; border-radius:10px; font-size:12.5px;
  width:max-content; max-width:90%; text-align:center; opacity:0; transition:opacity .25s, transform .25s; pointer-events:none;}
#toast.on{opacity:1; transform:translateX(-50%) translateY(-4px);}
.foot{text-align:center; font-size:12px; opacity:.4; letter-spacing:.05em;}
</style>
<style>
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;height:100%;}
body{
  background:
    repeating-linear-gradient(90deg, rgba(0,0,0,.07) 0 2px, transparent 2px 9px, rgba(255,255,255,.03) 9px 10px, transparent 10px 19px),
    repeating-linear-gradient(4deg, rgba(0,0,0,.05) 0 3px, transparent 3px 30px),
    radial-gradient(120% 80% at 50% -10%, #5a3d2c 0%, var(--wood) 55%, #1b120d 100%);
  color:var(--cream); font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  overscroll-behavior:none; touch-action:manipulation; user-select:none;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  min-height:100%; padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
}
#screen-menu{width:100%; max-width:480px; min-height:100vh; min-height:100dvh; box-sizing:border-box; display:flex; flex-direction:column; align-items:center; gap:14px; padding:20px;}

.gate-lantern{position:relative; width:20px; height:26px; border-radius:50% 50% 40% 40%;
  background:radial-gradient(circle at 40% 30%, #f0a868, #c8763a); box-shadow:0 0 14px rgba(232,150,80,.5);}
.gate-lantern::before,.gate-lantern::after{content:''; position:absolute; left:50%; width:1px; background:rgba(232,182,76,.6); transform:translateX(-50%);}
.gate-lantern::before{top:-10px; height:10px;} .gate-lantern::after{top:26px; height:10px;}
#lanterns{display:flex; gap:70px; margin-bottom:-6px;}

#titleblock{text-align:center;}
#titleblock h1{margin:0; font-size:clamp(26px,7vw,34px); letter-spacing:.05em; color:var(--gold);
  text-shadow:0 3px 10px rgba(0,0,0,.55);}
#titleblock .x{opacity:.6; font-weight:400; margin:0 4px;}
#titleblock p{margin:6px 0 0; font-size:11.5px; letter-spacing:.08em; opacity:.72; text-transform:uppercase;}

/* ---------- BIG GATE: fills nearly the whole screen; tap the handle to open ---------- */
#gate{width:100%; max-width:480px; flex:1; min-height:0; display:flex; flex-direction:column; cursor:pointer;}
#gate-roof{height:20px; margin:0 -8px -6px; position:relative; z-index:2; border-radius:14px 14px 3px 3px; flex:none;
  background:linear-gradient(160deg,#6b4a2e,#4a3220); box-shadow:0 3px 8px rgba(0,0,0,.45);}
#gate-roof::before{content:''; position:absolute; left:50%; top:-7px; width:34px; height:14px; transform:translateX(-50%);
  border-radius:50% 50% 0 0; background:linear-gradient(160deg,#7a5636,#4a3220);}
#gate-inner{position:relative; flex:1; min-height:0; border-radius:10px; overflow:hidden;
  background:linear-gradient(160deg,var(--panel),var(--panel2)); border:1px solid rgba(232,182,76,.32);
  box-shadow:inset 0 4px 14px rgba(0,0,0,.55), 0 10px 22px rgba(0,0,0,.45);}
.gate-door{position:absolute; top:0; bottom:0; width:50%;
  background:
    repeating-linear-gradient(0deg, transparent 0 24px, rgba(35,28,8,.4) 24px 27px),
    repeating-linear-gradient(90deg, var(--bamboo2) 0 8px, var(--bamboo3) 8px 9.5px, var(--bamboo) 9.5px 11px, var(--bamboo2) 11px 17px);
  box-shadow:inset 0 0 20px rgba(0,0,0,.5);
  transition:transform .6s cubic-bezier(.4,0,.2,1); z-index:3;}
.gate-door::before,.gate-door::after{content:''; position:absolute; left:10%; right:10%; height:6%;
  background:rgba(35,22,14,.65); border-radius:2px;}
.gate-door::before{top:18%;} .gate-door::after{bottom:18%;}
#door-l{left:0; border-radius:8px 0 0 8px;}
#door-r{left:50%; border-radius:0 8px 8px 0;}
#gate.open #door-l{transform:translateX(-105%);}
#gate.open #door-r{transform:translateX(105%);}
#gate.open .gate-door{pointer-events:none;}

/* ---------- FULL-SCREEN DOOR TRANSITION (return-to-menu wipe) ----------
   Same bamboo-door look as the main gate, but full-viewport: closes over
   whatever screen is showing, the underlying screen swaps to menu while
   fully hidden behind the shut doors, then the doors part to reveal it. */
#door-transition{position:fixed; inset:0; z-index:500; pointer-events:none;}
.dt-door{position:fixed; top:0; bottom:0; width:52%;
  background:
    repeating-linear-gradient(0deg, transparent 0 24px, rgba(35,28,8,.4) 24px 27px),
    repeating-linear-gradient(90deg, var(--bamboo2) 0 8px, var(--bamboo3) 8px 9.5px, var(--bamboo) 9.5px 11px, var(--bamboo2) 11px 17px);
  box-shadow:inset 0 0 30px rgba(0,0,0,.55), 0 0 24px rgba(0,0,0,.5);
  transition:transform .6s cubic-bezier(.4,0,.2,1);}
.dt-door::before,.dt-door::after{content:''; position:absolute; left:14%; right:14%; height:4%;
  background:rgba(35,22,14,.65); border-radius:2px;}
.dt-door::before{top:22%;} .dt-door::after{bottom:22%;}
#dt-door-l{left:0; transform:translateX(-100%);}
#dt-door-r{right:0; transform:translateX(100%);}
#door-transition.shut #dt-door-l{transform:translateX(0);}
#door-transition.shut #dt-door-r{transform:translateX(0);}
#gate-cta{position:absolute; inset:0; z-index:2; display:flex; flex-direction:column; align-items:center;
  justify-content:center; gap:10px; opacity:0; transition:opacity .35s .3s;}
#gate.open #gate-cta{opacity:1;}
#gate-cta b{color:var(--gold); font-size:16px; letter-spacing:.05em;}
#gate-hint{font-size:14px; opacity:.68; text-align:center; letter-spacing:.03em; min-height:14px;}
#gate.open ~ #gate-hint, #gate.open #gate-hint-inline{display:none;}
.btn{padding:15px 26px; border:0; border-radius:11px; font-size:17px; font-weight:800;
  background:linear-gradient(180deg,var(--gold),#c8912e); color:#2a1d0b; text-decoration:none; display:inline-block;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.45), inset 0 -2px 3px rgba(0,0,0,.22), 0 3px 0 0 #8a611c, 0 5px 8px rgba(0,0,0,.4);}
.foot{text-align:center; font-size:12px; opacity:.4; letter-spacing:.05em; margin-top:4px;}

/* ---------- SETTINGS ---------- */
#btn-settings{position:fixed; top:calc(env(safe-area-inset-top) + 12px); right:14px; width:48px; height:48px;
  border-radius:10px; background:rgba(0,0,0,.32); border:1px solid rgba(232,182,76,.28); color:var(--cream);
  font-size:19px; display:flex; align-items:center; justify-content:center; z-index:20; cursor:pointer;}
#mn-ov{position:fixed; inset:0; z-index:100; background:rgba(12,8,6,.86); backdrop-filter:blur(3px);
  display:none; align-items:center; justify-content:center; padding:18px;}
#mn-ov.on{display:flex;}
#mn-ovcard{width:100%; max-width:340px; background:linear-gradient(170deg,#3d2a20,#241812); border:1px solid rgba(232,182,76,.35);
  border-radius:16px; padding:18px; box-shadow:0 20px 50px rgba(0,0,0,.6);}
#mn-ovcard h2{margin:0 0 12px; font-size:17px; color:var(--gold); text-align:center; letter-spacing:.05em;}
.setting-row{display:flex; align-items:center; justify-content:space-between; gap:10px; padding:11px 3px;
  border-bottom:1px solid rgba(255,255,255,.08); font-size:13px;}
.setting-row:last-of-type{border-bottom:0;}
.switch{position:relative; width:42px; height:23px; border-radius:12px; background:rgba(0,0,0,.4);
  border:1px solid rgba(232,182,76,.3); flex:none; cursor:pointer;}
.switch::after{content:''; position:absolute; top:2px; left:2px; width:17px; height:17px; border-radius:50%;
  background:var(--cream); transition:transform .18s;}
.switch.on{background:rgba(143,191,82,.45); border-color:var(--jade);}
.switch.on::after{transform:translateX(19px);}
.btn.ghost{background:rgba(255,255,255,.09); color:var(--cream); border:1px solid rgba(255,255,255,.16);
  width:100%; text-align:center; box-sizing:border-box; cursor:pointer;}
.btn.danger{background:linear-gradient(180deg,#ff8a7c,var(--danger)); color:#2a0e0b;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.4), inset 0 -2px 3px rgba(0,0,0,.2), 0 3px 0 0 #a83228, 0 5px 8px rgba(0,0,0,.4);}
</style>
<style>
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;height:100%;}
body{
  background:
    repeating-linear-gradient(90deg, rgba(0,0,0,.07) 0 2px, transparent 2px 9px, rgba(255,255,255,.03) 9px 10px, transparent 10px 19px),
    repeating-linear-gradient(4deg, rgba(0,0,0,.05) 0 3px, transparent 3px 30px),
    radial-gradient(120% 80% at 50% -10%, #5a3d2c 0%, var(--wood) 55%, #1b120d 100%);
  color:var(--cream); font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  overscroll-behavior:none; touch-action:manipulation; user-select:none;
  display:flex; flex-direction:column; align-items:center; justify-content:flex-start;
  min-height:100%; padding:env(safe-area-inset-top) 0 env(safe-area-inset-bottom);
}
#screen-levelselect{width:100%; max-width:440px; margin:0 auto; padding:14px 10px 30px; display:flex; flex-direction:column; gap:4px;}

/* ---------- HEADER: cổng vào — mái ngói + đèn lồng, phong Trung Hoa cổ ---- */
#header{position:relative; text-align:center; padding:18px 10px 22px; margin-bottom:6px;}
#btn-ls-back{position:absolute; top:calc(env(safe-area-inset-top) + 6px); left:10px; width:48px; height:48px;
  border-radius:10px; background:rgba(0,0,0,.32); border:1px solid rgba(232,182,76,.28); color:var(--cream);
  font-size:19px; font-weight:700; display:flex; align-items:center; justify-content:center; z-index:20; cursor:pointer;}
#header::before{content:''; position:absolute; left:50%; top:0; width:86%; height:10px; transform:translateX(-50%);
  background:linear-gradient(160deg,#6b4a2e,#4a3220); border-radius:0 0 40% 40%/0 0 60% 60%;
  box-shadow:0 3px 6px rgba(0,0,0,.4);}
.lantern{position:absolute; top:2px; width:16px; height:20px; border-radius:50% 50% 40% 40%;
  background:radial-gradient(circle at 40% 30%, #f0a868, #c8763a); box-shadow:0 0 10px rgba(232,150,80,.45);}
.lantern::before,.lantern::after{content:''; position:absolute; left:50%; width:1px; height:8px; background:rgba(232,182,76,.6); transform:translateX(-50%);}
.lantern::before{top:-8px;} .lantern::after{top:20px;}
.lantern.l{left:12%;} .lantern.r{right:12%;}
#header h1{margin:14px 0 2px; font-size:22px; letter-spacing:.04em; color:var(--gold); text-shadow:0 2px 6px rgba(0,0,0,.5);}
#header p{margin:0; font-size:14px; opacity:.7; letter-spacing:.06em;}

/* ---------- CON ĐƯỜNG MÀN CHƠI ---------- */
#path{position:relative; display:flex; flex-direction:column; gap:30px; padding:14px 4px 20px;}
#path::before{content:''; position:absolute; left:50%; top:0; bottom:0; width:2px; transform:translateX(-50%); z-index:0;
  background:repeating-linear-gradient(to bottom, rgba(232,182,76,.4) 0 8px, transparent 8px 17px);}
.gate-row{position:relative; z-index:1; display:flex; flex-direction:column; align-items:center; width:168px;}
.gate-row:nth-child(odd){align-self:flex-start; margin-left:4%;}
.gate-row:nth-child(even){align-self:flex-end; margin-right:4%;}
.gate-num{width:24px; height:24px; border-radius:50%; background:linear-gradient(180deg,var(--gold),#c8912e);
  color:#2a1d0b; font-weight:900; font-size:12px; display:flex; align-items:center; justify-content:center;
  margin-bottom:5px; box-shadow:0 2px 6px rgba(0,0,0,.45); font-variant-numeric:tabular-nums;}

/* ---------- CỔNG TRE (gate) ---------- */
.gate{width:168px; cursor:pointer;}
.gate.locked{cursor:default;}
.gate-roof{height:13px; margin:0 -5px -4px; position:relative; z-index:2; border-radius:9px 9px 2px 2px;
  background:linear-gradient(160deg,#6b4a2e,#4a3220); box-shadow:0 2px 5px rgba(0,0,0,.45);}
.gate-inner{position:relative; aspect-ratio:.82; border-radius:6px; overflow:hidden;
  background:linear-gradient(160deg,var(--panel),var(--panel2)); border:1px solid rgba(232,182,76,.3);
  box-shadow:inset 0 3px 10px rgba(0,0,0,.5), 0 6px 14px rgba(0,0,0,.4); transition:filter .25s;}
.gate.locked .gate-inner{filter:grayscale(.55) brightness(.72);}
.door{position:absolute; top:0; bottom:0; width:50%;
  background:
    repeating-linear-gradient(0deg, transparent 0 18px, rgba(35,28,8,.4) 18px 20px),
    repeating-linear-gradient(90deg, var(--bamboo2) 0 6px, var(--bamboo3) 6px 7px, var(--bamboo) 7px 8px, var(--bamboo2) 8px 13px);
  box-shadow:inset 0 0 14px rgba(0,0,0,.45);
  transition:transform .5s cubic-bezier(.4,0,.2,1); z-index:3;}
.door::before,.door::after{content:''; position:absolute; left:10%; right:10%; height:7%;
  background:rgba(35,22,14,.62); border-radius:2px;}
.door::before{top:16%;} .door::after{bottom:16%;}
.door-left{left:0; border-radius:5px 0 0 5px;}
.door-right{left:50%; border-radius:0 5px 5px 0;}
.gate.open .door-left{transform:translateX(-105%);}
.gate.open .door-right{transform:translateX(105%);}
.gate.open .door{pointer-events:none;}
.gate-reveal{position:absolute; inset:0; z-index:2; display:flex; flex-direction:column; align-items:center;
  justify-content:center; gap:5px; padding:10px; text-align:center; opacity:0; transition:opacity .3s .22s;}
.gate.open .gate-reveal{opacity:1;}
.reveal-goal{font-size:22px; font-weight:900; color:var(--gold);}
.reveal-play{margin-top:3px; padding:14px 16px; border:0; border-radius:9px; font-size:16px; font-weight:800;
  background:linear-gradient(180deg,var(--gold),#c8912e); color:#2a1d0b;}
.lock-badge{position:absolute; inset:0; z-index:4; display:flex; align-items:center; justify-content:center; font-size:22px;}
.gate.current .gate-inner{box-shadow:inset 0 3px 10px rgba(0,0,0,.5), 0 0 0 2px var(--jade), 0 0 16px rgba(143,191,82,.55);}
.current-badge{position:absolute; top:6px; left:50%; transform:translateX(-50%); z-index:5; background:var(--jade); color:#182a10;
  font-size:11px; font-weight:800; letter-spacing:.04em; padding:2px 8px; border-radius:20px; box-shadow:0 2px 6px rgba(0,0,0,.4);
  pointer-events:none;}
.gate-label{margin-top:6px; font-size:17px; text-align:center; max-width:150px; opacity:.82; line-height:1.35;}
.gate.locked .gate-label{opacity:.5;}

#ls-toast{position:fixed; left:50%; bottom:22px; transform:translateX(-50%); z-index:90; background:rgba(20,14,10,.95);
  border:1px solid rgba(232,182,76,.4); color:var(--cream); padding:9px 14px; border-radius:10px; font-size:12.5px;
  width:max-content; max-width:88%; text-align:center; opacity:0; transition:opacity .25s, transform .25s; pointer-events:none;}
#ls-toast.on{opacity:1; transform:translateX(-50%) translateY(-4px);}
.foot{text-align:center; font-size:12px; opacity:.4; letter-spacing:.05em; margin-top:6px;}
</style>
<style>.hidden{display:none !important;}</style>
<style>
/* ---- ported from 24K-1-top-match-same-layer.html (gameplay CSS) ---- */
.legacy-hidden{display:none !important;}

/* ---------- HUD ---------- */
#hud{display:flex; align-items:center; gap:8px;}
.hud-box{flex:1; background:rgba(0,0,0,.28); border:1px solid rgba(232,182,76,.22); border-radius:10px; padding:5px 8px;}
.hud-lab{font-size:14px; letter-spacing:.08em; text-transform:uppercase; opacity:.68;}
.hud-val{font-size:16px; font-weight:800; font-variant-numeric:tabular-nums; line-height:1.15;}
.hud-val small{font-size:11px; font-weight:600; opacity:.6;}
#h-gl{font-size:23px;}
#h-gl small{font-size:14px; font-weight:700; opacity:.65;}
#goalbar{height:4px; background:rgba(255,255,255,.12); border-radius:3px; margin-top:3px; overflow:hidden;}
#goalfill{height:100%; width:0%; background:linear-gradient(90deg,var(--jade),var(--gold)); transition:width .3s;}
.hud-box-goal{flex:1.4; background:rgba(232,182,76,.16); border:1px solid rgba(232,182,76,.65);
  box-shadow:0 0 14px rgba(232,182,76,.3), inset 0 1px 0 rgba(255,255,255,.1);}
.hud-box-goal .hud-lab{color:var(--gold); opacity:1; font-weight:700;}
.hud-box-goal #h-gl{font-size:29px;}
.hud-box-seal{flex:.8; text-align:center; background:rgba(0,0,0,.24);}
.hud-box-seal .hud-lab{font-size:16px; opacity:.85;}
.hud-box-seal .hud-val{font-size:14px;}
.hud-box-goal #goalbar{height:6px; margin-top:4px;}
#btn-help{width:48px;height:48px;flex:none;border-radius:10px;background:rgba(0,0,0,.28);border:1px solid rgba(232,182,76,.22);color:var(--cream);font-size:18px;font-weight:700;}

/* ---------- KHAY ---------- */
#khay-wrap{
  background:linear-gradient(180deg,#432e22,#2e2018);
  border:1px solid rgba(232,182,76,.3); border-radius:14px; padding:7px 8px 8px;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.07), 0 4px 14px rgba(0,0,0,.4);
  position:relative; transition:box-shadow .2s, border-color .2s;
}
#khay-wrap.warn{border-color:rgba(255,93,81,.65); box-shadow:inset 0 1px 0 rgba(255,255,255,.07), 0 0 20px rgba(255,93,81,.35);}
#khay-wrap.warn #khay-title b{color:var(--danger);}
#khay-wrap.shake{animation:shake .34s;}
@keyframes shake{0%,100%{transform:translateX(0)}20%{transform:translateX(-5px)}40%{transform:translateX(5px)}60%{transform:translateX(-3px)}80%{transform:translateX(3px)}}
#khay-title{display:flex; align-items:baseline; gap:6px; font-size:10px; letter-spacing:.14em; text-transform:uppercase; opacity:.75; margin-bottom:5px;}
#khay-title b{font-size:11px; letter-spacing:0; opacity:1; color:var(--gold);}
#forecast{display:block; text-align:center; font-size:14px; letter-spacing:0; text-transform:none; font-weight:700; opacity:0; transition:opacity .12s; min-height:18px; margin-bottom:4px; color:var(--gold);}
#forecast.on{opacity:1;}
#forecast.bad{color:var(--danger);}
#forecast.ok{color:var(--jade);}
#khay{display:flex; gap:4px; justify-content:center;}
.slot{
  flex:1 1 0; max-width:46px; aspect-ratio:.78; border-radius:7px;
  background:rgba(0,0,0,.32); border:1px dashed rgba(246,236,216,.16);
  display:flex; align-items:center; justify-content:center; position:relative;
}
.slot.filled{border-style:solid; border-color:transparent; background:transparent;}
.slot.last{border-color:rgba(255,93,81,.5); background:rgba(255,93,81,.08);}
.slot .tile{width:100%; height:100%;}
.slot .ghostres{opacity:.34; filter:grayscale(.3);}
.slot.popping{animation:popslot .38s ease-out;}
@keyframes popslot{0%{transform:scale(1)}35%{transform:scale(1.3); filter:brightness(1.9)}100%{transform:scale(0); opacity:0}}
.slot.popping.big{animation:popslotbig .46s ease-out;}
@keyframes popslotbig{0%{transform:scale(1)}35%{transform:scale(1.6); filter:brightness(2.5)}100%{transform:scale(0); opacity:0}}

/* ---------- BOARD ---------- */
#board-wrap{position:relative; width:100%; display:flex; justify-content:center;}
#board{
  width:min(100%, 62vh); flex:none;
  display:grid; gap:3px; padding:6px; border-radius:14px;
  background:linear-gradient(160deg,var(--felt),var(--felt2));
  border:1px solid rgba(232,182,76,.22);
  box-shadow:inset 0 2px 10px rgba(0,0,0,.5), 0 6px 18px rgba(0,0,0,.35);
}
.cell{aspect-ratio:1; border-radius:6px; background:rgba(0,0,0,.22); box-shadow:inset 0 0 0 1px rgba(255,255,255,.035); position:relative;}
.cell.ghost{background:rgba(232,182,76,.2); box-shadow:inset 0 0 0 2px rgba(232,182,76,.75);}
.cell.ghostbad{background:rgba(255,93,81,.2); box-shadow:inset 0 0 0 2px rgba(255,93,81,.8);}
.cell.lineon::after,.cell.linebad::after{content:''; position:absolute; inset:0; border-radius:6px; pointer-events:none; z-index:3;}
.cell.lineon::after{box-shadow:inset 0 0 0 2px rgba(78,201,138,.95); background:rgba(78,201,138,.26);}
.cell.linebad::after{box-shadow:inset 0 0 0 2px rgba(255,93,81,1); background:rgba(255,93,81,.34);}
.cell.flash{animation:flash .22s ease-out;}
@keyframes flash{0%{filter:brightness(1)}45%{filter:brightness(2.6)}100%{filter:brightness(1)}}
.cell .tile{position:absolute; inset:0;}
.cell .tile.drop{animation:drop .19s cubic-bezier(.3,1.5,.5,1);}
@keyframes drop{0%{transform:scale(.55) translateY(-8px); opacity:.3}100%{transform:scale(1) translateY(0); opacity:1}}

/* ---------- Ô ẤN / CELL MỤC TIÊU ---------- */
.cell.target{
  background:linear-gradient(145deg,rgba(91,52,34,.96),rgba(35,22,17,.98));
  box-shadow:inset 0 0 0 2px rgba(232,182,76,.58), inset 0 0 14px rgba(0,0,0,.75);
  overflow:hidden;
}
.cell.target .tile.seal-tile{inset:5px; opacity:.54; filter:saturate(.68) brightness(.83); z-index:1;}
.cell.target .sealmark{
  position:absolute; inset:0; z-index:3; display:flex; align-items:center; justify-content:center;
  color:var(--gold); font-size:19px; font-weight:900; text-shadow:0 2px 5px #000;
  background:repeating-linear-gradient(45deg,transparent 0 7px,rgba(232,182,76,.13) 7px 9px);
  pointer-events:none;
}
.cell.target .sealhp{
  position:absolute; right:2px; top:2px; z-index:5; min-width:17px; height:17px; padding:0 4px;
  display:flex; align-items:center; justify-content:center; border-radius:9px;
  background:var(--danger); color:#fff; border:1px solid rgba(255,255,255,.65);
  font-size:10px; line-height:1; font-weight:900; box-shadow:0 1px 4px rgba(0,0,0,.6);
}
.cell.targetsoon{box-shadow:inset 0 0 0 3px var(--jade),0 0 14px rgba(78,201,138,.65)!important;}
.cell.targethit{animation:targethit .38s ease-out;}
@keyframes targethit{0%{filter:brightness(1)}35%{filter:brightness(3);transform:scale(1.08)}100%{filter:brightness(1);transform:scale(1)}}
.cell.breakflash{animation:breakflash .48s ease-out;}
@keyframes breakflash{0%{background:rgba(232,182,76,.9);transform:scale(1.08)}100%{background:rgba(0,0,0,.22);transform:scale(1)}}
.ghosttile{opacity:.5;}

/* ---------- TILE ART (ảnh thật, cắt từ Assets/Mahjong.png) ----------
 * Không còn badge số hạng (.rk) — mặt tile thật đã đủ để phân biệt (số chấm/
 * sách/hình gió-rồng-hoa), không cần thêm số đè lên nữa. */
/* This base rule is what tray pieces and the objective chips actually render with — the
   board-specific box-shadow/rounding further down only applies once a tile sits inside a
   .gravity-bottom/.gravity-top wrapper, so anywhere else (tray, objective card) a tile
   fell back to a bare rounded square with no depth or frame at all. Rounded-top corners
   (tile standing upright) + a thin gold frame + the same extrusion edge as the board's
   uncovered tile now make it read as a mahjong tile everywhere it appears, not just on
   the board — no cell/square indicator added, per feedback that wasn't needed. */
.tile{border-radius:9px; display:flex; align-items:center; justify-content:center; overflow:hidden; position:relative;
  background:rgba(255,255,255,.06);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.55), 5px 6px 0 var(--cream), 5px 6px 0 1px #a99c80, 0 9px 14px rgba(0,0,0,.55);}
.tile img{width:100%; height:100%; object-fit:contain; display:block; pointer-events:none;}

/* ---------- TRAY ---------- */
#tray-wrap{background:rgba(0,0,0,.24); border:1px solid rgba(232,182,76,.18); border-radius:14px; padding:8px;}
#tray{display:flex; gap:6px; align-items:center; justify-content:space-around; min-height:74px;}
.piece{flex:1; display:flex; align-items:center; justify-content:center; padding:5px 2px; border-radius:10px; position:relative; transition:transform .12s, background .12s;}
.piece.sel{background:rgba(232,182,76,.15); box-shadow:inset 0 0 0 2px rgba(232,182,76,.6); transform:translateY(-3px);}
.piece.used{opacity:.16; pointer-events:none;}
.pgrid{display:grid; gap:2px;}
.pgrid .tile{width:26px; height:32px;}
#tools{display:flex; gap:6px; margin-top:7px;}
.tool{flex:1; padding:8px 4px; border-radius:10px; border:1px solid rgba(232,182,76,.28); background:rgba(0,0,0,.3);
  color:var(--cream); font-size:11.5px; font-weight:700; display:flex; align-items:center; justify-content:center; gap:5px;}
.tool:disabled{opacity:.3;}
.tool.armed{background:rgba(255,93,81,.22); border-color:var(--danger); color:#ffd9d5;}
.tool b{color:var(--gold); font-variant-numeric:tabular-nums;}

/* ---------- FLOATING ---------- */
.fly{position:fixed; z-index:60; pointer-events:none;}
#dragghost{position:fixed; z-index:70; pointer-events:none; opacity:.92; filter:drop-shadow(0 6px 10px rgba(0,0,0,.5));}
#dragghost .pgrid{gap:3px;}
.float{position:fixed; z-index:80; pointer-events:none; font-weight:900; font-size:17px; color:var(--gold);
  text-shadow:0 2px 6px rgba(0,0,0,.8); animation:floatup 1s ease-out forwards;}
@keyframes floatup{0%{transform:translate(-50%,0) scale(.7); opacity:0}25%{transform:translate(-50%,-12px) scale(1.15); opacity:1}100%{transform:translate(-50%,-46px) scale(1); opacity:0}}
.spark{position:fixed; z-index:75; width:6px; height:6px; border-radius:50%; pointer-events:none;}
.shard{position:fixed; z-index:76; width:7px; height:9px; border-radius:2px; pointer-events:none; box-shadow:0 1px 3px rgba(0,0,0,.4);}

/* ---------- OVERLAY ---------- */
#ov{position:fixed; inset:0; z-index:100; background:rgba(12,8,6,.86); backdrop-filter:blur(3px);
  display:none; align-items:center; justify-content:center; padding:18px;}
#ov.on{display:flex;}
#ovcard{width:100%; max-width:360px; background:linear-gradient(170deg,#3d2a20,#241812); border:1px solid rgba(232,182,76,.35);
  border-radius:16px; padding:18px; box-shadow:0 20px 50px rgba(0,0,0,.6); max-height:86vh; overflow:auto;}
#ovcard h2{margin:0 0 4px; font-size:20px; color:var(--gold);}
#ovcard .sub{font-size:14px; opacity:.7; margin-bottom:12px;}
#ovcard p{font-size:15px; line-height:1.55; margin:0 0 9px;}
#ovcard ul{font-size:14px; line-height:1.6; padding-left:17px; margin:0 0 10px;}
#ovcard .hl{color:var(--gold); font-weight:700;}
#ovcard .dg{color:var(--danger); font-weight:700;}
.btn{width:100%; padding:15px; border-radius:11px; border:0; font-size:17px; font-weight:800;
  background:linear-gradient(180deg,var(--gold),#c8912e); color:#2a1d0b; margin-top:6px;}
.btn.ghost{background:rgba(255,255,255,.09); color:var(--cream); border:1px solid rgba(255,255,255,.16);}
.demo{display:flex; gap:4px; justify-content:center; margin:8px 0 12px;}
.demo .tile{width:30px;height:38px;}
.demo .arw{align-self:center; opacity:.6; font-size:16px; padding:0 3px;}
#toast{position:absolute; left:50%; bottom:10px; transform:translateX(-50%); z-index:90; background:rgba(20,14,10,.95);
  border:1px solid rgba(232,182,76,.4); color:var(--cream); padding:9px 14px; border-radius:10px; font-size:12.5px;
  width:max-content; max-width:90%; text-align:center; opacity:0; transition:opacity .25s, transform .25s; pointer-events:none;}
#toast.on{opacity:1; transform:translateX(-50%) translateY(-4px);}
.foot{text-align:center; font-size:12px; opacity:.4; letter-spacing:.05em;}
</style>
<style>
/* ---------- ZEN BACKGROUND (suối, tre, chim — nền cho toàn bộ 3 màn hình) ---------- */
#zen-bg{position:fixed; inset:0; z-index:-1; pointer-events:none; overflow:hidden;}
#zen-bg svg{width:100%; height:100%; display:block;}
.zb-leaves{animation:zbsway 5s ease-in-out infinite; transform-origin:4px 10px;}
.zb-bamboo.right .zb-leaves{animation-duration:6s;}
@keyframes zbsway{0%,100%{transform:rotate(0deg)} 50%{transform:rotate(3deg)}}
.bird-a{animation:zbfly1 9s ease-in-out infinite;}
.bird-b{animation:zbfly2 12s ease-in-out infinite .6s;}
.bird-c{animation:zbfly3 7.5s ease-in-out infinite 1.2s;}
@keyframes zbfly1{0%,100%{transform:translate(0,0)} 50%{transform:translate(30px,-12px)}}
@keyframes zbfly2{0%,100%{transform:translate(0,0)} 50%{transform:translate(-26px,9px)}}
@keyframes zbfly3{0%,100%{transform:translate(0,0)} 50%{transform:translate(20px,7px)}}
.zb-shimmer{animation:zbflow 7s linear infinite;}
.zb-shimmer2{animation:zbflow2 10s linear infinite reverse;}
@keyframes zbflow{to{stroke-dashoffset:-140;}}
@keyframes zbflow2{to{stroke-dashoffset:-170;}}

/* ---------- DOOR HANDLE (nắm cửa = nút bắt đầu) ---------- */
#door-handle{position:absolute; left:50%; top:50%; transform:translate(-50%,-50%) rotate(0deg); z-index:6;
  width:17%; aspect-ratio:1; min-width:40px; max-width:66px; border-radius:50%; border:0; padding:0; cursor:pointer;
  background:radial-gradient(circle at 35% 30%, #ffe9b0, var(--gold) 55%, #8a611c 100%);
  box-shadow:0 3px 8px rgba(0,0,0,.55), inset 0 1px 2px rgba(255,255,255,.6), inset 0 -2px 4px rgba(0,0,0,.35);
  transition:opacity .3s; animation:handlepulse 2.2s ease-in-out infinite, handlespin 4.5s linear infinite;}
#door-handle::before{content:''; position:absolute; inset:22%; border-radius:50%; border:2px solid rgba(60,38,10,.55);}
#door-handle::after{content:''; position:absolute; left:50%; top:50%; width:22%; height:22%; border-radius:50%;
  background:rgba(60,38,10,.65); transform:translate(-50%,-50%);}
@keyframes handlepulse{0%,100%{box-shadow:0 3px 8px rgba(0,0,0,.55), inset 0 1px 2px rgba(255,255,255,.6), inset 0 -2px 4px rgba(0,0,0,.35), 0 0 0 rgba(232,182,76,.5);} 50%{box-shadow:0 3px 8px rgba(0,0,0,.55), inset 0 1px 2px rgba(255,255,255,.6), inset 0 -2px 4px rgba(0,0,0,.35), 0 0 14px rgba(232,182,76,.65);}}
@keyframes handlespin{from{transform:translate(-50%,-50%) rotate(0deg);} to{transform:translate(-50%,-50%) rotate(360deg);}}
#gate.open #door-handle{opacity:0; pointer-events:none; transform:translate(-50%,-50%) scale(.6); animation:none;}

/* ---------- RESULT BANNER (thắng/thua — không chặn thao tác, tự biến mất) ---------- */
#result-banner{position:absolute; left:50%; top:10px; transform:translate(-50%,-160%); z-index:95;
  background:linear-gradient(170deg,#3d2a20,#241812); border:1px solid rgba(232,182,76,.45); border-radius:13px;
  padding:10px 20px; text-align:center; box-shadow:0 10px 26px rgba(0,0,0,.5); pointer-events:none;
  transition:transform .4s cubic-bezier(.2,.9,.3,1.2), opacity .35s; opacity:0; max-width:88%; white-space:nowrap;}
#result-banner.on{transform:translate(-50%,0); opacity:1;}
#result-banner b{display:block; font-size:15px; color:var(--gold); letter-spacing:.03em;}
#result-banner.lose b{color:var(--danger);}
#result-banner span{display:block; font-size:12px; opacity:.75; margin-top:2px;}

/* ---------- RESET LINK (thay cho confirm() gốc — bấm 2 lần để xác nhận) ---------- */
.reset-link{background:none; border:0; color:var(--cream); opacity:.35; font-size:11px; letter-spacing:.03em;
  text-decoration:underline; padding:4px; margin-top:-8px; cursor:pointer;}
.reset-link.armed{opacity:.85; color:var(--danger);}
</style>
</head>
<body>
