      K_DOMINO_H('d1', 'c2', 's2'),
      K_DOMINO_H('d2', 'w1', 'c1'),
      K_DOMINO_H('final', 'c1', 'w1'),
    ],
    // 1) I3 at (0,0): c1@(0,0) lone, w1@(0,1) matches seed w1@(1,1) -> distinct id #1 (w1).
    // 2) L3 at (2,0): s1@(2,0) lone, s2@(3,0) matches seed s2@(4,0) -> distinct id #2 (s2)
    //    -> sealRequiredDistinct(2) met, seal at col5 rows3-5 opens. s1@(3,1) lone.
    // 3) domino at (1,2): c2@(1,2) matches leftover c2@(0,2) from move1; s2@(1,3) lone.
    // 4) domino at (5,3): w1@(5,3), c1@(5,4) both land lone (harmless, seal already open).
    // 5) domino at (3,4): c1 lands z1 on the exposed floor c1@(3,4,0) -> adjacent to the
    //    STACK's roof c1@(3,3,1) -> wave1 match reveals buried s1@(3,3,0); its 2nd cell w1
    //    lands at (3,5) — only legal because the seal opened at move 2 — into the now-open
    //    cell. Wave2: revealed s1@(3,3,0) matches seed s1@(2,3,0) -> winTargets s1 need:2 met.
    solution: [
      { row: 0, col: 0 },
      { row: 2, col: 0 },
      { row: 1, col: 2 },
      { row: 5, col: 3 },
      { row: 3, col: 4 },
    ],
  },
  {
    title: 'Sixth Face',
    size: 6,
    goalType: 'TARGET_FACE',
    winTargets: [
      { id: 's1', need: 2 },
      { id: 'c1', need: 2 },
      { id: 'w1', need: 2 },
      { id: 's2', need: 2 },
      { id: 'c2', need: 2 },
    ],
    targetRequiredCount: 3,
    permanents: [[5, 0], [5, 1], [5, 2]],
    guideMoves: 1,
    lesson: 'SIXTH FACE (F) IS A FREE DECOY · FINISH ANY 3 OF 5 TARGET FACES',
    teach: '',
    tiles: [
      P24K_TILE('s1', 0, 1, 0),
      P24K_TILE('c1', 1, 2, 0),
      P24K_TILE('w1', 4, 0, 0),
      P24K_TILE('c2', 3, 2, 0),
      P24K_TILE('s2', 2, 2, 0),
    ],
    sequence: [
      P24M_L3('l3', 's1', 'w2', 'c1'),   // roadmap "L3 AFB": A=s1, F=w2 (new face), B=c1
      K_DOMINO_H('dh', 'w1', 'c2'),      // roadmap "D-H CE": C=w1, E=c2
      K_DOMINO_H('d3', 'w2', 's2'),
      K_DOMINO_H('d4', 's1', 'w1'),
      K_DOMINO_H('d5', 'c2', 's2'),
    ],
    // 1) L3 at (0,0): s1@(0,0) matches seed s1@(0,1) [face s1 done]; w2@(1,0) lone (decoy,
    //    first appearance of F); c1@(1,1) matches seed c1@(1,2) [face c1 done].
    // 2) domino at (3,0): w1@(3,0) matches seed w1@(4,0) [face w1 done]; c2@(3,1) matches
    //    seed c2@(3,2) [face c2 done]. targetRequiredCount(3) already satisfied here.
    // 3) domino at (2,0): w2@(2,0) matches the earlier decoy w2@(1,0) (a bonus, not a target
    //    face); s2@(2,1) matches seed s2@(2,2) [face s2 done too].
    // 4)-5) harmless padding placements on open cells away from the permanent row.
    solution: [
      { row: 0, col: 0 },
      { row: 3, col: 0 },
      { row: 2, col: 0 },
      { row: 5, col: 3 },
      { row: 0, col: 4 },
    ],
  },
  {
    title: 'Three Faces, Two Stations',
    size: 6,
    goalType: 'TARGET_FACE',
    winTargets: [
      { id: 's1', need: 2 },
      { id: 'c1', need: 2 },
      { id: 'w1', need: 2 },
      { id: 's2', need: 2 },
      { id: 'c2', need: 2 },
      { id: 'w2', need: 2 },
    ],
    targetRequiredCount: 4,
    seals: [[0, 4], [0, 5], [1, 4], [1, 5]],
    sealRequiredDistinct: 3,
    permanents: [[4, 4], [4, 5], [5, 4], [5, 5]],
    guideMoves: 0,
    lesson: 'TARGET FACE 4 OF 6 · SEAL NEEDS 3 DISTINCT · PERMANENT BLOCK CORNER',
    teach: '',
    // Two "stations": an I3 lane (s1,w1,w2) at cols 0-2 and an L3 lane (c1,s2,c2)
    // at cols 3-5, each pre-seeded so the SECOND occurrence of that piece lands
    // adjacent to the first and pairs off all three of its faces at once.
    tiles: [
      P24K_TILE('c1', 1, 3, 0), // seed: pairs with L3's c1 cell on move 2
      P24K_TILE('s2', 4, 3, 0), // seed: pairs with L3's s2 cell on move 2
      P24K_TILE('c2', 3, 5, 0), // seed: pairs with L3's c2 cell on move 2
    ],
    sequence: [
      P24M_I3H('i3', 's1', 'w1', 'w2'), // roadmap "I3 ACF"
      P24M_L3('l3', 'c1', 's2', 'c2'),  // roadmap "L3 BDE"
    ],
    solution: [
      { row: 2, col: 0 }, // I3H: s1,w1,w2 land on empty floor, no match yet
      { row: 2, col: 3 }, // L3: c1@(2,3) pairs seed c1@(1,3); s2@(3,3) pairs seed s2@(4,3);
                          //     c2@(3,4) pairs seed c2@(3,5) -> 3 pairs, seal opens (3 distinct)
      { row: 3, col: 0 }, // I3H directly under move 1 -> s1,w1,w2 each pair vertically
                          //     -> all 6 faces now at idCounts 2, target quota (4 of 6) met
      { row: 0, col: 4 }, // L3 into the now-open seal cells (0,4)/(1,4)/(1,5) - shows the
                          //     unblocked seal behaving like normal empty cells
      { row: 4, col: 0 }, // I3H filler placement, legal open floor
      { row: 0, col: 0 }, // L3 filler placement, legal open floor
    ],
  },
  {
    title: 'Chapter Final Exam',
    size: 6,
    goalType: 'BURIED_TARGET',
    // 3 total buried target tiles: 2x s1 (one stack each) + 1x w2 (one stack).
    winTargets: [
      { id: 's1', need: 2 },
      { id: 'w2', need: 1 },
    ],
    seals: [[0, 4], [0, 5], [1, 4], [1, 5], [2, 5]],
    sealRequiredDistinct: 3,
    permanents: [[3, 5], [4, 4], [4, 5], [5, 4], [5, 5]],
    guideMoves: 0,
    lesson: 'FINAL EXAM · GRAVITY REVEAL · SAME LAYER · SEAL AND PERMANENT',
    teach: '',
    tiles: [
      ...P24M_STACK('s1', 'c1', 2, 0), // buried target #1: s1 under roof c1
      ...P24M_STACK('s1', 'w1', 2, 1), // buried target #2: s1 under roof w1
      ...P24M_STACK('w2', 's2', 2, 2), // buried target #3: w2 under roof s2
      P24K_TILE('c1', 1, 0, 0), // trigger seed: gives the I3 piece's c1 cell a floor to
      P24K_TILE('w1', 1, 1, 0), // stack onto (z1), landing it adjacent to each roof so
      P24K_TILE('s2', 1, 2, 0), // all three roofs match away on the very same drop
      P24K_TILE('w2', 2, 3, 0), // partner for the revealed w2 target
    ],
    sequence: [
      P24M_L3('l3', 's1', 'c2', 'w2'),  // roadmap "L3 AEF"
      P24M_I3H('i3', 'c1', 'w1', 's2'), // roadmap "I3 BCD"
    ],
    solution: [
      { row: 4, col: 0 }, // L3 filler: s1,c2,w2 on empty floor, no match
      // I3H lands its c1/w1/s2 cells on the row-1 seeds (each floor already occupied,
      // so each lands z1) directly under nothing but adjacent above each roof:
      // wave 1 matches c1+c1, w1+w1, s2+s2 (3 distinct -> seal opens) and reveals the
      // three buried tiles; wave 2: the two revealed s1 tiles are now mutually adjacent
      // and match each other (need 2 met), and the revealed w2 matches its seed
      // partner at (2,3) (need 1 met) -> BURIED_TARGET goal fully met.
      { row: 1, col: 0 },
      { row: 0, col: 4 }, // L3 filler into the now-open seal cells
      { row: 3, col: 0 }, // I3H filler, empty floor
      { row: 4, col: 2 }, // L3 filler, empty floor
      { row: 2, col: 0 }, // I3H onto the row-1 leftovers -> another harmless triple match
      { row: 0, col: 1 }, // L3 filler, empty floor (row 1 cleared by the previous move)
      { row: 2, col: 0 }, // I3H filler -> matches the row-3 leftovers from move 4, harmless
    ],
  }
]
.map((level,i)=>({
  ...level,cap:0,rr:0,fl:0,targets:[],index:i,
  suits:['s','c','w'],maxRank:8,honors:0,
  tiles:level.tiles.map(tile=>({...tile,id:P24K1_FACE_MAP[tile.id]||tile.id})),
  sequence:level.sequence.map(piece=>({...piece,cells:piece.cells.map(cell=>({...cell,id:P24K1_FACE_MAP[cell.id]||cell.id}))})),
  /* winTargets is authored with the same convenient raw ids as tiles/sequence above
     (e.g. 'c1'), so it must go through the same P24K1_FACE_MAP remap — otherwise a
     target written as 'c1' can never match, because every actual tile with that raw
     id gets renamed to its mapped face (e.g. 'c2') before it ever reaches the board. */
  winTargets:(level.winTargets||[]).map(t=>({...t,id:P24K1_FACE_MAP[t.id]||t.id}))
}));

P24K_LEVELS.splice(0,P24K_LEVELS.length,...P24M_LEVELS);
LEVELS.splice(0,LEVELS.length,...P24M_LEVELS);
boardEl.classList.add('top-match-board');

/* Render trực tiếp 8 ảnh của proto-mechanic; không đi qua artwork/fallback cũ. */
/* "block-face" (only ever passed for an exposed, uncovered board bottom tile — see
   p24kBoardCellHTML) swaps in TILE_IMG_BLOCK: the same face art re-exported with a
   baked-in 2-tone beveled edge, so the "this is a solid tile" cue lives in the asset's
   own pixels instead of depending on a CSS box-shadow around a flat image. Every other
   context (tray, covered bottom, roof tile) keeps the plain TILE_IMG face untouched. */
tileHTML=function(t,extraCls){
  if(!t||!P24K1_ASSET_IDS.includes(t.id)||!TILE_IMG[t.id])return '';
  const wantsBlock=(extraCls||'').indexOf('block-face')!==-1;
  const src=(wantsBlock&&TILE_IMG_BLOCK&&TILE_IMG_BLOCK[t.id])?TILE_IMG_BLOCK[t.id]:TILE_IMG[t.id];
  const cls=['tile','proto-mechanic-tile',(extraCls||'').replace('block-face','').trim()].filter(Boolean).join(' ');
  return `<div class="${cls}" data-face="${t.id}" data-asset-set="proto-match-top"><img src="${src}" alt="${t.id}" draggable="false"></div>`;
};

const p24mStyle=document.createElement('style');
p24mStyle.textContent=`
#board.top-match-board .cell{overflow:hidden;isolation:isolate}
#board.top-match-board .proto-mechanic-tile,#tray .proto-mechanic-tile,#p24k-dragghost .proto-mechanic-tile{background:transparent}
#board.top-match-board .proto-mechanic-tile img,#tray .proto-mechanic-tile img,#p24k-dragghost .proto-mechanic-tile img{width:100%;height:100%;object-fit:contain;display:block}
#board.top-match-board .cell.stack-cell{background:linear-gradient(145deg,rgba(84,164,216,.24),rgba(20,45,59,.2));box-shadow:inset 0 0 0 2px rgba(123,205,255,.42),inset -5px -5px 10px rgba(0,0,0,.25)}
/* The covered/stacked look was already fine as-is — reverted the dimming+hatch attempt.
   The real gap was the single, uncovered floor tile: it had almost no "thick mahjong
   block" feel next to a stacked pair. Bevel + a bolder two-tone extrusion edge + a
   heavier drop shadow now give it the same physical weight as a real tile. */
#board.top-match-board .gravity-bottom.is-covered{inset:auto 1px 1px auto;width:auto;height:calc(100% - 4px);aspect-ratio:3/4;opacity:1;filter:none;transform:none;z-index:2}
#board.top-match-board .gravity-bottom.is-covered>.tile{box-shadow:3px 5px 0 #6e7940,3px 6px 0 #35401f,0 5px 9px rgba(0,0,0,.5)}
/* This is the actual selector for a board tile at the bottom layer with nothing on top
   of it. Earlier passes made the extruded edge bigger but kept it dark-olive — nearly the
   same tone as the board's own dark green background, so it barely registered no matter
   the size. A real tile's side is still ivory, just shaded, not a dark color — switching
   to a light warm-tan edge against the dark board is the actual fix: contrast, not size. */
/* The beveled edge now lives in the asset itself (TILE_IMG_BLOCK, via block-face) — this
   rule just adds rounded-top corners and an ambient drop shadow for "resting on the
   board" weight, instead of also drawing its own extrusion lines on top of the baked-in
   ones (which read as a doubled/cluttered edge). */
#board.top-match-board .gravity-bottom:not(.is-covered)>.tile{border-radius:7px;box-shadow:0 3px 0 rgba(0,0,0,.32),0 10px 15px rgba(0,0,0,.62)}
#board.top-match-board .gravity-top{inset:1px auto auto 1px;width:auto;height:calc(100% - 4px);aspect-ratio:3/4;z-index:6;transform:none;filter:none;box-shadow:3px 5px 0 #8a6038,3px 6px 0 #40291a,0 9px 12px rgba(0,0,0,.7);border-radius:7px}
#board.top-match-board .gravity-top>.tile{clip-path:none;border-radius:7px;box-shadow:inset 0 0 0 2px rgba(255,239,196,.7),inset 0 0 0 4px rgba(201,145,90,.42),inset 0 2px 0 rgba(255,255,255,.35),0 3px 6px rgba(0,0,0,.4)}
#board.top-match-board .gravity-top .rk{font-size:14px;opacity:1}
#board.top-match-board .gravity-layer.just-dropped>.tile{animation:k1FloorLand .18s cubic-bezier(.22,.9,.32,1) both;animation-delay:calc(var(--drop-order,0)*40ms)}
#board.top-match-board .gravity-top.just-dropped>.tile{animation-name:k1RoofLand}
#board.top-match-board .gravity-layer.just-revealed>.tile{animation:k1Reveal .4s cubic-bezier(.16,1.05,.35,1)}
#board.top-match-board .gravity-layer.match-pop>.tile{animation:k1MatchPop calc(.34s + var(--n,0)*.05s) ease-out forwards;animation-delay:calc(var(--pop-order,0)*45ms)}
#board.top-match-board .cell.top-clearing{z-index:10;animation:k1CellMatch calc(.34s + var(--n,0)*.05s) ease-in-out}
#board.top-match-board .cell.top-clearing .gravity-bottom{filter:brightness(1.45) saturate(1.25)}
#board.top-match-board .cell.just-revealing{animation:k1RevealRing .4s ease-out;z-index:9}
#board.top-match-board .cell.gravity-roof{background:rgba(83,164,219,.26);box-shadow:inset 0 -4px 0 rgba(83,164,219,.35),inset 0 0 0 3px rgba(114,204,255,.9),0 0 10px rgba(83,164,219,.52)}
#board.top-match-board .cell .gravity-ghost.gravity-ghost-top{inset:1px auto auto 1px;width:auto;height:calc(100% - 4px);aspect-ratio:3/4;opacity:.82;z-index:10;transform:none;clip-path:none;box-shadow:2px 4px 0 rgba(74,147,194,.8),0 7px 10px rgba(0,0,0,.55)}
#board.top-match-board .cell.tutorial-guide{animation:k1Guide 1.15s ease-in-out infinite;z-index:3}
#board.shake{animation:shake .3s;}
.k1-shock{position:fixed;z-index:45;pointer-events:none;border-radius:50%;transform:translate(-50%,-50%);
  background:radial-gradient(circle,rgba(255,214,112,.55) 0%,rgba(255,214,112,.22) 45%,transparent 72%);
  animation:k1Shock .4s ease-out forwards;}
#khay .gravity-copy .phase{display:block;margin-bottom:2px;color:#fff3c9;font-size:10px;font-weight:950;letter-spacing:.12em}
#khay .gravity-copy b{font-size:15px;letter-spacing:.03em}
#khay .gravity-copy.phase-gravity b{color:#79c7ff}#khay .gravity-copy.phase-match b{color:#93efad}#khay .gravity-copy.phase-reveal b{color:#ffd271}
@keyframes k1FloorLand{0%{transform:translateY(-52px) scale(.84);opacity:.4;filter:brightness(1.25)}70%{transform:translateY(3px) scale(1.03);opacity:1;filter:brightness(1.05)}100%{transform:translateY(0) scale(1);filter:brightness(1)}}
@keyframes k1RoofLand{0%{transform:translateY(-64px) scale(.82);opacity:.35;filter:brightness(1.3)}70%{transform:translateY(4px) scale(1.04);opacity:1;filter:brightness(1.05)}100%{transform:translateY(0) scale(1);filter:brightness(1)}}
@keyframes k1MatchPop{0%{transform:scale(1);filter:brightness(1)}18%{transform:scale(calc(1.22 + var(--n,0)*.09));filter:brightness(calc(2.2 + var(--n,0)*.45))}50%{transform:scale(calc(1.1 + var(--n,0)*.05));filter:brightness(calc(1.6 + var(--n,0)*.3))}100%{transform:scale(0);filter:brightness(2.8);opacity:0}}
@keyframes k1Reveal{0%{clip-path:inset(0 0 100% 0);filter:brightness(1)}45%{clip-path:inset(0 0 0 0);filter:brightness(1.7) saturate(1.15);box-shadow:inset 0 0 0 2px rgba(255,244,214,.9),0 0 14px rgba(255,244,214,.6)}100%{clip-path:inset(0 0 0 0);filter:brightness(1);box-shadow:inset 0 0 0 0 rgba(255,244,214,0)}}
@keyframes k1RevealRing{0%{box-shadow:0 0 0 0 rgba(255,244,214,.6)}100%{box-shadow:0 0 0 10px rgba(255,244,214,0)}}
@keyframes k1CellMatch{0%,100%{box-shadow:inset 0 0 0 2px rgba(143,191,82,.4)}45%{box-shadow:inset 0 0 0 calc(4px + var(--n,0)*1.5px) var(--ring-color,#8fbf52),0 0 calc(18px + var(--n,0)*8px) var(--ring-glow,rgba(143,191,82,.95))}}
@keyframes k1Shock{0%{transform:translate(-50%,-50%) scale(.25);opacity:.8}100%{transform:translate(-50%,-50%) scale(1);opacity:0}}
@keyframes k1Guide{0%,100%{box-shadow:inset 0 0 0 2px rgba(232,182,76,.38),0 0 0 rgba(232,182,76,0)}50%{box-shadow:inset 0 0 0 3px rgba(255,214,112,.96),0 0 14px rgba(232,182,76,.7)}}
/* One-time visual-only tutorial cue, Level 1 exclusively (see p24kUpdateGuideHand): a bouncing
   hand glyph over the exact guided cell, on top of the .tutorial-guide glow every level already
   has. Lives outside #board (position:fixed, appended to body) because #board's cells clip
   overflow and renderBoard() rewrites .cell innerHTML on every render, which would wipe a child
   element placed inside a cell. */
.guide-hand{position:fixed; z-index:46; pointer-events:none; font-size:30px; line-height:1;
  transform:translate(-50%,-20%); text-shadow:0 3px 8px rgba(0,0,0,.65);
  animation:k1GuideHand 1.1s ease-in-out infinite; display:none;}
@keyframes k1GuideHand{0%,100%{transform:translate(-50%,-14%) scale(1)}50%{transform:translate(-50%,-30%) scale(1.08)}}
/* Reduced Motion: JS pacing (the sleep() waits in p24kResolveAnimated/p24kPlace) is left
   untouched so turn-taking timing doesn't change — only the decorative motion itself is
   cut to near-instant, per the spec's Reduced Motion requirement (previously unimplemented). */
@media (prefers-reduced-motion: reduce){
  #board.top-match-board .gravity-layer.just-dropped>.tile,
  #board.top-match-board .gravity-top.just-dropped>.tile,
  #board.top-match-board .gravity-layer.just-revealed>.tile,
  #board.top-match-board .gravity-layer.match-pop>.tile,
  #board.top-match-board .cell.top-clearing,
  #board.top-match-board .cell.just-revealing,
  #board.top-match-board .cell.tutorial-guide,
  #board.shake,
  .k1-shock,
  .guide-hand{animation-duration:.01ms!important;animation-delay:0s!important;}
}
/* Ô Chắn — permanently blocked cell: a dark, inert hollow. Never changes, never opens. */
#board.top-match-board .cell-permanent{background:radial-gradient(120% 120% at 40% 30%,#1c1712,#0a0806 70%);box-shadow:inset 0 4px 10px rgba(0,0,0,.85),inset 0 -2px 0 rgba(255,255,255,.03);}
#board.top-match-board .cell-permanent::after{content:'';position:absolute;inset:18%;border-radius:40%;background:radial-gradient(circle at 35% 30%,#3a332c,#171310 70%);box-shadow:inset 0 2px 4px rgba(0,0,0,.6);}
/* Phong Ấn — temporary seal: a bamboo plank, deliberately not tile-shaped, with a soft
   gold pulse inviting the player to work toward opening it. Cracks and falls away once
   the distinct-face requirement is met (see p24kMaybeOpenSeal). */
#board.top-match-board .cell-sealed{background:transparent;}
.seal-plank{position:absolute;inset:5%;border-radius:5px;
  background:repeating-linear-gradient(90deg,var(--bamboo2) 0 7px,var(--bamboo3) 7px 8.5px,var(--bamboo) 8.5px 10px,var(--bamboo2) 10px 15px);
  box-shadow:inset 0 0 0 1px rgba(0,0,0,.35),inset 0 2px 4px rgba(255,255,255,.15),0 3px 6px rgba(0,0,0,.5);
  animation:sealGlow 2.4s ease-in-out infinite;}
.seal-plank::before,.seal-plank::after{content:'';position:absolute;background:rgba(232,182,76,.75);box-shadow:0 0 4px rgba(232,182,76,.5);}
.seal-plank::before{left:14%;right:14%;top:50%;height:2px;transform:translateY(-50%) rotate(18deg);}
.seal-plank::after{top:14%;bottom:14%;left:50%;width:2px;transform:translateX(-50%) rotate(-14deg);}
@keyframes sealGlow{0%,100%{box-shadow:inset 0 0 0 1px rgba(0,0,0,.35),inset 0 2px 4px rgba(255,255,255,.15),0 3px 6px rgba(0,0,0,.5);}50%{box-shadow:inset 0 0 0 1px rgba(232,182,76,.4),inset 0 2px 4px rgba(255,255,255,.2),0 0 12px rgba(232,182,76,.45);}}
.cell-sealed.opening .seal-plank{animation:sealBreak .46s ease-in forwards;}
@keyframes sealBreak{0%{transform:scale(1) rotate(0deg);opacity:1;filter:brightness(1);}40%{transform:scale(1.08) rotate(-3deg);opacity:1;filter:brightness(1.8);}100%{transform:scale(.4) rotate(14deg) translateY(30px);opacity:0;filter:brightness(2.2);}}
@media(max-width:430px){#board.top-match-board .gravity-top .rk{font-size:13px}}
/* Tray pieces (the piece you're about to drag) stay exactly as they were — the rounded-
   top-corner + gold-frame + extrusion treatment on the shared .tile rule was meant for the
   board/objective-card context, not the tray. Reverting it here specifically, since
   #tray .gravity-pcell>.tile is more specific than the bare .tile rule it overrides. */
#tray .gravity-pcell>.tile,#p24k-dragghost .tile{border-radius:6px;box-shadow:none}
.goal-icon{display:inline-block;width:19px;height:24px;vertical-align:middle;margin-right:4px;position:relative;top:3px;filter:drop-shadow(0 0 5px rgba(232,182,76,.55))}
.goal-icon .tile,.goal-icon .proto-mechanic-tile{width:19px;height:24px;position:relative}
.obj-row{display:flex;gap:10px;justify-content:center;margin:8px 0 4px}
.obj-chip{display:flex;flex-direction:column;align-items:center;gap:2px}
.obj-chip .tile,.obj-chip .proto-mechanic-tile{width:38px;height:48px;position:relative}
.obj-chip b{font-size:14px;color:var(--gold);font-weight:800}
`;
document.head.appendChild(p24mStyle);
if(typeof p24kBack!=='undefined'&&p24kBack){p24kBack.href='index.html';p24kBack.setAttribute('aria-label','Back to level select');}

function p24mIsExposed(tile,tiles=P24K.tiles){return !!(tile&&tile.alive&&(tile.z===1||!p24kTileAt(tile.r,tile.c,1,tiles)));}
function p24mTopAt(r,c,tiles=P24K.tiles){return p24kTileAt(r,c,1,tiles)||p24kTileAt(r,c,0,tiles);}

p24kNeighbors=function(tile,tiles=P24K.tiles){
  return [[-1,0],[0,-1],[0,1],[1,0]].map(([dr,dc])=>p24mTopAt(tile.r+dr,tile.c+dc,tiles)).filter(Boolean);
};

/* Connected-component grouping: a "wave" clears every maximal group of same-id,
   same-z, exposed, orthogonally-connected tiles touching the active set — not just
   greedy pairs. A group of 2 is an ordinary Match; 3 or 4 is a bonus that the engine
   supports whenever it happens naturally (levels are not authored to chase it). */
p24kFindWavePairs=function(activeUids,tiles=P24K.tiles){
  const active=new Set(activeUids),visited=new Set(),groups=[];
  const order=[...active].map(uid=>tiles.find(t=>t.uid===uid)).filter(t=>p24mIsExposed(t,tiles)).sort((a,b)=>a.r-b.r||a.c-b.c||a.z-b.z||a.uid-b.uid);
  for(const seed of order){
    if(visited.has(seed.uid))continue;
    const seen=new Set([seed.uid]),stack=[seed],group=[];
    while(stack.length){
      const t=stack.pop();
      group.push(t.uid);
      for(const q of p24kNeighbors(t,tiles)){
        if(seen.has(q.uid)||!p24mIsExposed(q,tiles)||q.id!==seed.id||q.z!==seed.z)continue;
        seen.add(q.uid);stack.push(q);
      }
    }
    group.forEach(uid=>visited.add(uid));
    if(group.length>=2)groups.push(group.slice().sort((a,b)=>a-b));
  }
  return groups;
};

p24kApplyWave=function(groups,activeUids,tiles=P24K.tiles){
  const removed=new Set(groups.flat()),ids=[],reveals=[];
  for(const group of groups){
    const members=group.map(uid=>tiles.find(t=>t.uid===uid)).filter(t=>t&&t.alive);
    if(members.length<2)continue;
    ids.push(members[0].id);
    for(const tile of members){
      if(tile.z===1){const under=p24kTileAt(tile.r,tile.c,0,tiles);if(under&&under.alive)reveals.push(under.uid);}
      tile.alive=false;
    }
  }
  const uniqueReveals=[...new Set(reveals)];
  const next=new Set([...activeUids].filter(uid=>!removed.has(uid)).filter(uid=>p24mIsExposed(tiles.find(t=>t.uid===uid),tiles)));
  uniqueReveals.forEach(uid=>next.add(uid));
  // justRevealed is intentionally NOT set here — the animated caller (p24kResolveAnimated)
  // decides when to flip it, so a plain "empty socket" frame can render before the reveal
  // flourish plays. The pure model path (self-tests/solution checks) doesn't need the flag.
  return {pairs:groups.map(x=>x.slice()),ids,reveals:uniqueReveals,falls:[],active:next};
};

p24kResolveAllModel=function(tiles,activeUids){
  let active=new Set(activeUids),waves=0,pairCount=0;const events=[],idCounts={};
  while(true){
    const groups=p24kFindWavePairs(active,tiles);if(!groups.length)break;
    waves++;pairCount+=groups.reduce((s,g)=>s+(g.length-1),0);
    const step=p24kApplyWave(groups,active,tiles);active=step.active;
    step.pairs.forEach((group,gi)=>{const id=step.ids[gi];idCounts[id]=(idCounts[id]||0)+group.length;});
    events.push({type:'match',wave:waves,pairs:step.pairs,ids:step.ids.slice()});
    if(step.reveals.length)events.push({type:'reveal',wave:waves,uids:step.reveals.slice()});
  }
  return {waves,pairCount,events,active,idCounts};
};

/* Phong Ấn (seal) and Ô Chắn (permanent) cells block a whole cell at both layers.
   `sealOpen` is passed in rather than read from S directly so the solver's isolated
   model (which tracks its own sealOpen as moves are replayed) can reuse this same
   check instead of accidentally reading live game state. */
function p24kCellBlocked(level,sealOpen,r,c){
  if(level.permanents&&level.permanents.some(p=>p[0]===r&&p[1]===c))return true;
  if(!sealOpen&&level.seals&&level.seals.some(s=>s[0]===r&&s[1]===c))return true;
  return false;
}
/* Phong Ấn opens only once, only after a full cascade has settled (never mid-drag or
   mid-wave — S.targetCounts already accumulates every distinct id ever matched this
   level, across all waves and turns, so its key-count is exactly "distinct faces
   matched so far" with no extra bookkeeping needed). */
async function p24kMaybeOpenSeal(){
  const lvl=p24kLevel();
  if(S.sealOpen||!lvl.sealRequiredDistinct||!lvl.seals||!lvl.seals.length)return;
  if(Object.keys(S.targetCounts).length<lvl.sealRequiredDistinct)return;
  S.sealOpen=true;
  sfx.sealOpen();
  lvl.seals.forEach(([sr,sc])=>{
    const el=boardEl.querySelector(`.cell-sealed[data-r="${sr}"][data-c="${sc}"]`);
    if(el)el.classList.add('opening');
  });
  await sleep(460);
  renderAll();
}
p24kSimulateDrop=function(r,c,index=0,tiles=P24K.tiles,pieces=P24K.pieces,level=p24kLevel(),sealOpen=S.sealOpen){
  if(index!==0)return {legal:false,reason:'preview'};
  const piece=pieces[0];if(!piece)return {legal:false,reason:'missing'};const placements=[];
  for(let n=0;n<piece.cells.length;n++){
    const cell=piece.cells[n],rr=r+cell.dr,cc=c+cell.dc;
    if(rr<0||cc<0||rr>=level.size||cc>=level.size)return {legal:false,reason:'bounds'};
    if(p24kCellBlocked(level,sealOpen,rr,cc))return {legal:false,reason:'blocked',blockedAt:[rr,cc]};
    const bottom=p24kTileAt(rr,cc,0,tiles),top=p24kTileAt(rr,cc,1,tiles);
    if(top)return {legal:false,reason:'full',blockedAt:[rr,cc]};
    placements.push({dr:cell.dr,dc:cell.dc,id:cell.id,r:rr,c:cc,z:bottom?1:0,tempUid:-(n+1)});
  }
  const projected=p24kCloneTiles(tiles);
  placements.forEach(p=>projected.push({uid:p.tempUid,id:p.id,r:p.r,c:p.c,z:p.z,alive:true}));
  const active=new Set(placements.map(p=>p.tempUid)),directPairs=p24kFindWavePairs(active,projected);
  const resolved=p24kResolveAllModel(projected,new Set(active));
  const floorCount=placements.filter(p=>p.z===0).length,topCount=placements.length-floorCount;
  return {legal:true,index:0,piece,r,c,placements,floorCount,topCount,directPairs,willMatch:directPairs.length>0,willCascade:resolved.waves>1,previewPairs:resolved.pairCount,previewWaves:resolved.waves};
};
simulate=p24kSimulateDrop;

function p24mGuideMove(){const level=p24kLevel();if(P24K.phase!=='idle'||S.placed>=level.guideMoves)return null;return level.solution[S.placed]||null;}
// Shared by the Hint booster (p24kUseHint) below — set to a {row,col} anchor to pulse
// that cell with the exact same .tutorial-guide highlight the tutorial guideMoves uses,
// instead of inventing a second highlight visual for the booster.
let __hintCell=null;
function p24mIsGuideCell(r,c){const move=p24mGuideMove()||__hintCell,piece=P24K.pieces[0];return !!(move&&piece&&piece.cells.some(cell=>move.row+cell.dr===r&&move.col+cell.dc===c));}

p24kBoardCellHTML=function(r,c){
  const lvl=p24kLevel();
  if(lvl.permanents&&lvl.permanents.some(p=>p[0]===r&&p[1]===c)){
    return `<div class="cell cell-permanent" data-r="${r}" data-c="${c}"></div>`;
  }
  if(!S.sealOpen&&lvl.seals&&lvl.seals.some(s=>s[0]===r&&s[1]===c)){
    return `<div class="cell cell-sealed" data-r="${r}" data-c="${c}"><div class="seal-plank"></div></div>`;
  }
  const bottom=p24kTileAt(r,c,0),top=p24kTileAt(r,c,1),stack=!!bottom&&!!top;let inner='';
  if(bottom){const cls=['gravity-layer','gravity-bottom',stack?'is-covered':'',bottom.justDropped?'just-dropped':'',bottom.justRevealed?'just-revealed':''].filter(Boolean).join(' ');const faceCls='gravity-tile'+(stack?'':' block-face');inner+=`<div class="${cls}" style="--drop-order:${bottom.dropOrder||0}" data-uid="${bottom.uid}" data-z="0">${tileHTML(T(bottom.id),faceCls)}</div>`;}
  if(top){const cls=['gravity-layer','gravity-top',top.justDropped?'just-dropped':''].filter(Boolean).join(' ');inner+=`<div class="${cls}" style="--drop-order:${top.dropOrder||0}" data-uid="${top.uid}" data-z="1">${tileHTML(T(top.id),'gravity-tile')}</div>`;}
  return `<div class="cell${stack?' stack-cell':''}${p24mIsGuideCell(r,c)?' tutorial-guide':''}" data-r="${r}" data-c="${c}">${inner}</div>`;
};

/* Status strip is now icon/chip-only — the phase used to be spelled out as a full
   sentence ("TỪNG CELL ĐANG RƠI", "HAI MẶT ĐANG LỘ SÁNG XANH"...); the animations
   themselves (drop, match-pop, reveal sweep) now carry that meaning, so only a small
   color-coded dot plus the pair counter / level lesson remain as text. */
renderKhay=function(){
  khayEl.className='gravity-status';const last=P24K.lastTurn;
  if(P24K.phase==='gravity'){khayEl.innerHTML='<div class="gravity-copy phase-gravity"><b>●</b></div>';return;}
  if(P24K.phase==='match'){khayEl.innerHTML='<div class="gravity-copy phase-match"><b>●</b></div>';return;}
  if(P24K.phase==='reveal'){khayEl.innerHTML='<div class="gravity-copy phase-reveal"><b>●</b></div>';return;}
  if(last&&last.waves){khayEl.innerHTML=`<div class="gravity-copy"><b>${last.pairs} PAIRS</b></div>`;return;}
  khayEl.innerHTML='<div class="gravity-copy"></div>';
};

clearPreview=function(){
  boardEl.querySelectorAll('.cell').forEach(el=>el.classList.remove('ghost','ghostbad','gravity-floor','gravity-roof','gravity-match','gravity-bad','support-clearing','top-clearing'));
  boardEl.querySelectorAll('.gravity-ghost').forEach(el=>el.remove());const f=$('forecast');f.className='';f.textContent='';S.prev=null;
};

showPreview=function(r,c,index=0){
  clearPreview();const sim=p24kSimulateDrop(r,c,index);if(!sim.legal){p24kShowBadPreview(r,c,P24K.pieces[0]);return;}
  S.prev={r,c,i:0,sim};const pairUids=new Set(sim.directPairs.flat());
  sim.placements.forEach(p=>{const el=boardEl.querySelector(`.cell[data-r="${p.r}"][data-c="${p.c}"]`);if(!el)return;el.classList.add(pairUids.has(p.tempUid)?'gravity-match':(p.z===1?'gravity-roof':'gravity-floor'));el.insertAdjacentHTML('beforeend',tileHTML(T(p.id),`gravity-ghost${p.z===1?' gravity-ghost-top':''}`));});
  sim.directPairs.flat().forEach(uid=>{const t=P24K.tiles.find(x=>x.uid===uid);if(t)boardEl.querySelector(`.cell[data-r="${t.r}"][data-c="${t.c}"]`)?.classList.add('gravity-match');});
};

/* Group size (2/3/4) drives --n (0/1/2): bigger clears get a bigger scale/brightness pop,
   a bigger cell-ring (jade at n=0, gold escalation at n>=1), and — only at size>=3 — a
   radial "shockwave" burst at the group's centroid; size 4 also gives the board a
   micro-shake. All of this is meant to read as "how big was that clear" with zero text. */
p24kMarkPairAnimation=function(groups,waveNo=1){
  groups.forEach(group=>{
    const n=Math.max(0,Math.min(2,group.length-2));
    const ringColor=n>=1?'#ffd670':'#8fbf52',ringGlow=n>=1?'rgba(255,214,112,.92)':'rgba(143,191,82,.95)';
    let cx=0,cy=0,count=0;
    group.forEach((uid,idx)=>{
      const tile=P24K.tiles.find(t=>t.uid===uid);if(!tile)return;
      const layer=boardEl.querySelector(`.gravity-layer[data-uid="${uid}"]`);
      if(layer){layer.style.setProperty('--n',n);layer.style.setProperty('--pop-order',idx);layer.classList.add('match-pop');}
      const cell=boardEl.querySelector(`.cell[data-r="${tile.r}"][data-c="${tile.c}"]`);
      if(cell){
        cell.style.setProperty('--n',n);cell.style.setProperty('--ring-color',ringColor);cell.style.setProperty('--ring-glow',ringGlow);
        cell.classList.add('gravity-match','top-clearing');
        const rect=cell.getBoundingClientRect();const px=rect.left+rect.width/2,py=rect.top+rect.height/2;
        cx+=px;cy+=py;count++;
        shatter(px,py,PRAISE_COLORS[n]);
      }
    });
    if(count){
      cx/=count;cy/=count;
      floatTxt(cx,cy-8,PRAISE_WORDS[n],PRAISE_COLORS[n]);
    }
    if(count&&group.length>=3){
      const size=120+group.length*60;
      const shock=document.createElement('div');shock.className='k1-shock';
      shock.style.left=cx+'px';shock.style.top=cy+'px';shock.style.width=size+'px';shock.style.height=size+'px';
      document.body.appendChild(shock);setTimeout(()=>shock.remove(),420);
    }
    if(group.length>=4){boardEl.classList.add('shake');setTimeout(()=>boardEl.classList.remove('shake'),320);}
  });
  if(waveNo>=2){
    const br=boardEl.getBoundingClientRect();
    floatTxt(br.left+br.width/2,br.top+br.height*.28,`CHAIN ×${waveNo}!`,'#ffe9b0');
  }
};

p24kResolveAnimated=async function(activeUids){
  let active=new Set(activeUids),waves=0,pairsTotal=0;const events=[];
  while(true){
    const groups=p24kFindWavePairs(active);if(!groups.length)break;
    waves++;const maxSize=Math.max(...groups.map(g=>g.length)),waveTiles=groups.reduce((s,g)=>s+g.length,0);
    const maxN=Math.max(...groups.map(g=>Math.max(0,Math.min(2,g.length-2))));
    P24K.phase='match';renderKhay();p24kMarkPairAnimation(groups,waves);
    const br=boardEl.getBoundingClientRect();sparks(br.left+br.width/2,br.top+br.height*.45,maxSize>=3?'#ffd670':PAIR_COLOR,12+maxSize*6);sfx.pop(waves-1);
    await sleep(340+maxN*50);
    const step=p24kApplyWave(groups,active);active=step.active;
    let wavePairs=0,waveScore=0;for(const g of groups){wavePairs+=(g.length-1);waveScore+=160+(g.length-2)*120;}
    S.pairs+=wavePairs;S.score+=waveScore;pairsTotal+=wavePairs;
    step.pairs.forEach((group,gi)=>{const id=step.ids[gi];S.targetCounts[id]=(S.targetCounts[id]||0)+group.length;});
    events.push({type:'match',wave:waves,pairs:step.pairs,ids:step.ids.slice()});
    if(step.reveals.length){
      // Beat 1: render the now-empty top slot plainly (no glow yet) so cause and effect
      // read as two distinct moments instead of one blur.
      renderAll();await sleep(80);
      P24K.phase='reveal';renderKhay();sfx.reveal();
      step.reveals.forEach(uid=>{const t=P24K.tiles.find(x=>x.uid===uid);if(t)t.justRevealed=true;});
      events.push({type:'reveal',wave:waves,uids:step.reveals.slice()});
      // Beat 2: the reveal sweep + outward ivory ring plays now that the flag is set.
      renderAll();
      step.reveals.forEach(uid=>{
        const cell=boardEl.querySelector(`.gravity-layer[data-uid="${uid}"]`)?.closest('.cell');
        if(cell){cell.classList.add('just-revealing');setTimeout(()=>cell.classList.remove('just-revealing'),400);}
      });
      await sleep(320);
    }else{
      renderAll();await sleep(180);
    }
    P24K.tiles.forEach(t=>{t.justDropped=false;t.justRevealed=false;});
  }
  return {active,waves,pairs:pairsTotal,events};
};

p24kPlace=async function(r,c,index=0){
  if(S.busy)return {legal:false,reason:'busy'};const sim=p24kSimulateDrop(r,c,index);if(!sim.legal)return sim;
  S.busy=true;P24K.phase='gravity';clearPreview();__hintCell=null;const piece=P24K.pieces[0],newUids=[];
  for(let n=0;n<sim.placements.length;n++){const p=sim.placements[n],tile={uid:P24K.nextUid++,id:p.id,r:p.r,c:p.c,z:p.z,alive:true,justDropped:true,justRevealed:false,dropOrder:n,source:piece.key};P24K.tiles.push(tile);newUids.push(tile.uid);}
  S.placed++;if(Number.isFinite(S.movesLeft))S.movesLeft--;S.score+=piece.cells.length*5;P24K.queueIndex++;p24kSyncQueue();P24K.lastTurn={piece:piece.key,row:r,col:c,waves:0,pairs:0,events:[{type:'land',uids:newUids.slice(),floor:sim.floorCount,top:sim.topCount}]};
  renderAll();sfx.place();await sleep(180+Math.max(0,sim.placements.length-1)*40);P24K.tiles.forEach(t=>t.justDropped=false);const result=await p24kResolveAnimated(new Set(newUids));P24K.lastTurn.waves=result.waves;P24K.lastTurn.pairs=result.pairs;P24K.lastTurn.events.push(...result.events);P24K.phase='idle';renderAll();
  await p24kMaybeOpenSeal();
  if(levelWon()){S.busy=false;return win();}
  if(Number.isFinite(S.movesLeft)&&S.movesLeft<=0){S.busy=false;return lose('HẾT LƯỢT ĐI','Đã dùng hết số lượt di chuyển cho phép.');}
  if(!p24kLegalMoves().length){S.busy=false;return lose('NO VALID FOOTPRINT LEFT','The current block has no position where every cell stays within the two-layer limit.');}
  S.busy=false;renderHUD();return {legal:true,...result};
};
place=p24kPlace;

p24kLegalMoves=function(tiles=P24K.tiles,pieces=P24K.pieces,level=p24kLevel()){
  const out=[];for(let r=0;r<level.size;r++)for(let c=0;c<level.size;c++){const sim=p24kSimulateDrop(r,c,0,tiles,pieces,level);if(sim.legal)out.push({piece:0,row:r,col:c,floor:sim.floorCount,top:sim.topCount,willMatch:sim.willMatch,willCascade:sim.willCascade});}return out;
};
p24kFirstLegalMove=function(){return p24kLegalMoves()[0]||null;};

/* All mechanic-explanation prose removed from these three overlays. The only content now
   is: level name/number, the objective shown as actual tile faces + a target count (not a
   sentence), and score/progress numbers. Nothing here tells the player HOW the mechanic
   works — that's taught entirely by guideMoves' pulsing-cell highlight during play. */
startLevel=function(n=0){
  S.lv=Math.max(0,Math.min(P24M_LEVELS.length-1,n));S.cfg=p24kLevel();S.size=S.cfg.size;S.ids=buildIds(S.cfg);S.board=emptyBoard(S.size);S.khay=[];S.tray=[];S.targets=[];S.pairs=0;S.sel=-1;S.prev=null;S.rerolls=0;S.flushes=0;S.busy=false;S.armFlush=false;S.placed=0;S.score=0;S.chainBest=0;S.targetCounts={};S.sealOpen=false;
  S.movesLeft=S.cfg.moveLimit>0?S.cfg.moveLimit:Infinity;S.boosterReroll=S.cfg.boosterReroll||0;S.boosterHint=S.cfg.boosterHint||0;__hintCell=null;
  P24K.nextUid=1;P24K.queueIndex=0;P24K.tiles=S.cfg.tiles.map(t=>({...t,uid:P24K.nextUid++,alive:true,justDropped:false,justRevealed:false,dropOrder:0}));p24kSyncQueue();P24K.lastTurn=null;P24K.phase='idle';
  const title=$('khay-title');if(title&&title.firstChild)title.firstChild.nodeValue='';renderAll();
};

win=function(){
  S.busy=true;P24K.phase='won';sfx.win();
  const last=S.lv===P24M_LEVELS.length-1;
  if(typeof p24kUnlockLevel==='function')p24kUnlockLevel(Math.min(S.lv+1,P24M_LEVELS.length-1));
  resultBanner(`LEVEL ${S.lv+1} COMPLETE`,'',false);
  setTimeout(()=>{
    if(last){ S.busy=false; if(typeof showScreen==='function') showScreen('levelselect'); }
    else { startLevel(S.lv+1); }
  },1500);
};
lose=function(title){
  S.busy=true;P24K.phase='lost';sfx.lose();
  const t=(p24kLevel().winTargets||[])[0];const cur=t?(S.targetCounts[t.id]||0):S.pairs;const tot=t?t.need:p24kLevel().pairGoal;
  resultBanner(title,`${cur}/${tot}`,true);
  setTimeout(()=>{ startLevel(S.lv); },1400);
};

/* Win condition switched from "N pairs of anything" to "clear a specific tile type N times",
   tracked in S.targetCounts (see p24kResolveAnimated). Falls back to the old pairGoal check
   for any level that has no winTargets, so nothing breaks if one is ever left unset. */
goalState=function(){
  const lvl=p24kLevel();
  if(lvl.goalType==='OPEN_SEAL'){
    return {label:'GOAL',current:Math.min(lvl.sealRequiredDistinct,Object.keys(S.targetCounts).length),total:lvl.sealRequiredDistinct,targetId:null};
  }
  const targets=lvl.winTargets||[];
  if(!targets.length)return {label:'GOAL',current:S.pairs,total:lvl.pairGoal||1,targetId:null};
  if(lvl.targetRequiredCount){
    const done=targets.filter(t=>(S.targetCounts[t.id]||0)>=t.need).length;
    return {label:'GOAL',current:Math.min(lvl.targetRequiredCount,done),total:lvl.targetRequiredCount,targetId:null};
  }
  const t=targets[0];
  return {label:'GOAL',current:Math.min(t.need,S.targetCounts[t.id]||0),total:t.need,targetId:t.id};
};
levelWon=function(){
  const lvl=p24kLevel();
  if(lvl.goalType==='OPEN_SEAL')return !!S.sealOpen;
  const targets=lvl.winTargets||[];
  if(targets.length){
    if(lvl.targetRequiredCount)return targets.filter(t=>(S.targetCounts[t.id]||0)>=t.need).length>=lvl.targetRequiredCount;
    return p24mTargetsMet(lvl,S.targetCounts);
  }
  return S.pairs>=(lvl.pairGoal||1);
};

/* No text-based help overlay for this mode by design — the "?" button's only job used
   to be showing a wall of mechanic-explanation prose, which is exactly what's being
   removed, so it's hidden rather than left as dead UI that opens nothing. */
{const btnHelp=$('btn-help');if(btnHelp)btnHelp.style.display='none';}

/* Two boosters, both level-authored (level.boosterReroll/boosterHint starting charges,
   0 = booster hidden for that level) and neither costs a move — they're a rescue valve
   on top of S.movesLeft, not an alternate way to spend one.
   - Đổi khối ("swap"): skips the current queue slot forward by one, same authored
     sequence, no new randomness (keeps every level's validated solvability model intact
     outside of the deliberate deviation the player is choosing to make).
   - Hint: runs a bounded DFS from the ACTUAL live board (see p24kTrySolveLive below,
     defined further down near p24mGoalMet) so it stays correct even if the player's
     path has diverged from level.solution, then pulses the same .tutorial-guide cell
     guideMoves already uses via __hintCell. */
function p24kRenderTools(){
  const box=$('tools');if(!box)return;
  const lvl=p24kLevel();
  const showTools=!!(lvl.boosterReroll||lvl.boosterHint);
  box.classList.toggle('hidden',!showTools);
  if(!showTools)return;
  const rBtn=$('btn-reroll'),hBtn=$('btn-hint');
  if(rBtn){
    rBtn.style.display=lvl.boosterReroll?'':'none';
    rBtn.disabled=S.busy||!(S.boosterReroll>0);
    const b=rBtn.querySelector('b');if(b)b.textContent=S.boosterReroll;
  }
  if(hBtn){
    hBtn.style.display=lvl.boosterHint?'':'none';
    hBtn.disabled=S.busy||!(S.boosterHint>0);
    const b=hBtn.querySelector('b');if(b)b.textContent=S.boosterHint;
  }
}
function p24kUseReroll(){
  if(S.busy||!(S.boosterReroll>0))return;
  S.boosterReroll--;P24K.queueIndex++;p24kSyncQueue();clearPreview();__hintCell=null;renderAll();
  toast('Đã đổi sang khối tiếp theo');
}
function p24kUseHint(){
  if(S.busy||!(S.boosterHint>0))return;
  toast('Đang tìm gợi ý…',900);
  setTimeout(()=>{
    const move=(typeof p24kTrySolveLive==='function')?p24kTrySolveLive():null;
    if(!move){ toast('Không tìm được gợi ý cho trạng thái hiện tại'); return; }
    S.boosterHint--;__hintCell=move;renderAll();
    setTimeout(()=>{ if(__hintCell===move){ __hintCell=null; renderBoard(); } },4000);
  },20);
}
{const rBtn=$('btn-reroll');if(rBtn)rBtn.addEventListener('click',p24kUseReroll);}
{const hBtn=$('btn-hint');if(hBtn)hBtn.addEventListener('click',p24kUseHint);}

p24kFreshModel=function(levelIndex){const level=P24M_LEVELS[levelIndex];return {level,tiles:level.tiles.map((t,i)=>({...t,uid:i+1,alive:true,justRevealed:false})),queueIndex:0,pieces:[p24kQueuePiece(0,level,0),p24kQueuePiece(1,level,0)],nextUid:level.tiles.length+1,pairs:0,events:[],idCounts:{},sealOpen:false};};
p24kModelDrop=function(model,r,c){
  const sim=p24kSimulateDrop(r,c,0,model.tiles,model.pieces,model.level,model.sealOpen);if(!sim.legal)return {legal:false,sim};const active=[];
  for(const p of sim.placements){const tile={uid:model.nextUid++,id:p.id,r:p.r,c:p.c,z:p.z,alive:true};model.tiles.push(tile);active.push(tile.uid);}
  model.queueIndex++;model.pieces=[p24kQueuePiece(0,model.level,model.queueIndex),p24kQueuePiece(1,model.level,model.queueIndex)];const result=p24kResolveAllModel(model.tiles,new Set(active));model.pairs+=result.pairCount;
  model.idCounts=model.idCounts||{};Object.entries(result.idCounts).forEach(([id,n])=>{model.idCounts[id]=(model.idCounts[id]||0)+n;});
  if(!model.sealOpen&&model.level.sealRequiredDistinct&&Object.keys(model.idCounts).length>=model.level.sealRequiredDistinct)model.sealOpen=true;
  model.events.push({type:'land',floor:sim.floorCount,top:sim.topCount},...result.events);return {legal:true,sim,result};
};
function p24mTargetsMet(level,idCounts){return (level.winTargets||[]).every(t=>(idCounts&&idCounts[t.id]||0)>=t.need);}
function p24mGoalMet(level,model){
  if(level.goalType==='OPEN_SEAL')return !!model.sealOpen;
  const targets=level.winTargets||[];
  if(targets.length){
    if(level.targetRequiredCount)return targets.filter(t=>(model.idCounts[t.id]||0)>=t.need).length>=level.targetRequiredCount;
    return p24mTargetsMet(level,model.idCounts);
  }
  return model.pairs>=level.pairGoal;
}
p24kRunSolution=function(levelIndex){
  const model=p24kFreshModel(levelIndex),level=model.level;let ok=true;
  for(const move of level.solution){if(!p24kModelDrop(model,move.row,move.col).legal){ok=false;break;}}
  const goalOk=p24mGoalMet(level,model);
  return {ok:ok&&goalOk,pairs:model.pairs,model};
};

/* Live-state solver backing the Hint booster (p24kUseHint above). Unlike p24kRunSolution
   (which replays level.solution from a FRESH model), this snapshots the board exactly as
   the player left it — so the hint stays correct even after boosters/deviation from the
   authored solution path. p24kLegalMoves() itself always reads S.sealOpen, which is wrong
   for a cloned hypothetical model mid-search, so this needs its own sealOpen-aware variant
   (mirrors the level-editor's p24kLegalMoves, which already takes a full model). */
function p24kLiveModelSnapshot(){
  return {
    level:p24kLevel(), tiles:p24kAlive().map(t=>({...t})), queueIndex:P24K.queueIndex,
    pieces:[p24kClonePiece(P24K.pieces[0]),p24kClonePiece(P24K.pieces[1])], nextUid:P24K.nextUid,
    pairs:S.pairs, events:[], idCounts:{...S.targetCounts}, sealOpen:S.sealOpen,
  };
}
function p24kLegalMovesForModel(model){
  const out=[];
  for(let r=0;r<model.level.size;r++)for(let c=0;c<model.level.size;c++){
    const sim=p24kSimulateDrop(r,c,0,model.tiles,model.pieces,model.level,model.sealOpen);
    if(sim.legal)out.push({row:r,col:c});
  }
  return out;
}
function p24kTrySolveLive(){
  const maxNodes=50000,maxDepth=24;let nodes=0;const seen=new Set();
  function keyOf(m){return m.tiles.filter(t=>t.alive).map(t=>t.id+'@'+t.r+'_'+t.c+'_'+t.z).sort().join(',')+'|'+m.queueIndex;}
  function dfs(model,depth,firstMove){
    if(p24mGoalMet(model.level,model))return firstMove;
    if(depth>=maxDepth||nodes++>maxNodes)return null;
    const key=keyOf(model);if(seen.has(key))return null;seen.add(key);
    for(const mv of p24kLegalMovesForModel(model)){
      const clone=JSON.parse(JSON.stringify(model));
      const res=p24kModelDrop(clone,mv.row,mv.col);
      if(!res.legal)continue;
      const fm=firstMove||{row:mv.row,col:mv.col};
      const found=dfs(clone,depth+1,fm);
      if(found)return found;
    }
    return null;
  }
  return dfs(p24kLiveModelSnapshot(),0,null);
}

function p24mSelfTest(){
  const checks={};
  checks.thirty_levels=P24M_LEVELS.length===30;
  checks.guide_moves_valid=P24M_LEVELS.every(level=>Number.isInteger(level.guideMoves)&&level.guideMoves>=0);
  checks.every_level_has_one_lesson=P24M_LEVELS.every(level=>typeof level.lesson==='string'&&level.lesson.length>4);
  checks.every_queue_item_is_polyomino=P24M_LEVELS.every(level=>level.sequence.every(piece=>piece.cells.length>=2));
  checks.piece_size_within_cap=P24M_LEVELS.every(level=>level.sequence.every(piece=>piece.cells.length<=5));
  // Level 1 is the doc's sanctioned exception: a deliberate one-touch [A][A] domino so the
  // very first placement matches immediately with zero board-reading required. Every other
  // level must not bake in a free match.
  checks.no_baked_self_match=P24M_LEVELS.every((level,i)=>i===0||level.sequence.every(piece=>!p24mPieceHasBakedSelfMatch(piece)));
  checks.self_match_guard_catches_bad_piece=p24mPieceHasBakedSelfMatch(P24K_PIECE('bad',[[0,0,'s1'],[0,1,'s1']]))===true&&p24mPieceHasBakedSelfMatch(P24K_PIECE('good',[[0,0,'s1'],[0,1,'c1']]))===false;
  checks.match_group_of_three_clears_together=(()=>{const tiles=[{uid:1,id:'s1',r:0,c:0,z:0,alive:true},{uid:2,id:'s1',r:0,c:1,z:0,alive:true},{uid:3,id:'s1',r:0,c:2,z:0,alive:true}];const groups=p24kFindWavePairs(new Set([1,2,3]),tiles);return groups.length===1&&groups[0].length===3;})();
  checks.match_group_of_four_clears_together=(()=>{const tiles=[{uid:1,id:'s1',r:0,c:0,z:0,alive:true},{uid:2,id:'s1',r:0,c:1,z:0,alive:true},{uid:3,id:'s1',r:1,c:0,z:0,alive:true},{uid:4,id:'s1',r:1,c:1,z:0,alive:true}];const groups=p24kFindWavePairs(new Set([1,2,3,4]),tiles);return groups.length===1&&groups[0].length===4;})();
  checks.group_of_three_awards_two_pair_equivalents=(()=>{const tiles=[{uid:1,id:'s1',r:0,c:0,z:0,alive:true},{uid:2,id:'s1',r:0,c:1,z:0,alive:true},{uid:3,id:'s1',r:0,c:2,z:0,alive:true}];const result=p24kResolveAllModel(tiles,new Set([1,2,3]));return result.waves===1&&result.pairCount===2;})();
  checks.five_cell_piece_places_without_crashing=(()=>{
    const piece=P24M_L5('probe','w2','s2','c2','w1','s1');
    if(p24mPieceHasBakedSelfMatch(piece))return false;
    const model={level:{size:6,sequence:[piece]},tiles:[],queueIndex:0,pieces:[piece,piece],nextUid:1,pairs:0,events:[]};
    const drop=p24kModelDrop(model,0,0);
    return drop.legal&&drop.sim.placements.length===5;
  })();
  checks.gravity_uses_lowest_slot=(()=>{const tiles=[{uid:1,id:'w1',r:1,c:1,z:0,alive:true}],pieces=[K_DOMINO_H('x','s1','c1'),K_DOMINO_H('y','w1','c1')];const sim=p24kSimulateDrop(1,1,0,tiles,pieces,P24M_LEVELS[9]);return sim.legal&&sim.placements[0].z===1&&sim.placements[1].z===0;})();
  checks.full_column_rejected=(()=>{const tiles=[{uid:1,id:'w1',r:1,c:1,z:0,alive:true},{uid:2,id:'c1',r:1,c:1,z:1,alive:true}],pieces=[K_DOMINO_H('x','s1','c1'),K_DOMINO_H('y','w1','c1')];return p24kSimulateDrop(1,1,0,tiles,pieces,P24M_LEVELS[9]).reason==='full';})();
  checks.covered_bottom_is_ignored=(()=>{const tiles=[{uid:1,id:'s1',r:0,c:0,z:0,alive:true},{uid:2,id:'c1',r:0,c:0,z:1,alive:true},{uid:3,id:'s1',r:0,c:1,z:0,alive:true}];return p24kFindWavePairs(new Set([1]),tiles).length===0;})();
  checks.cross_height_pair_is_ignored=(()=>{const tiles=[{uid:1,id:'s1',r:0,c:0,z:0,alive:true},{uid:2,id:'w1',r:0,c:1,z:0,alive:true},{uid:3,id:'s1',r:0,c:1,z:1,alive:true}];return p24kFindWavePairs(new Set([3]),tiles).length===0;})();
  checks.same_layer_roof_pair_matches=(()=>{const tiles=[{uid:1,id:'c1',r:0,c:0,z:0,alive:true},{uid:2,id:'w1',r:0,c:1,z:0,alive:true},{uid:3,id:'s1',r:0,c:0,z:1,alive:true},{uid:4,id:'s1',r:0,c:1,z:1,alive:true}];return p24kFindWavePairs(new Set([3,4]),tiles).length===1;})();
  // Seal / permanent mechanics (new for the 30-level design).
  checks.permanent_cell_blocks_placement=(()=>{const level={size:4,permanents:[[1,1]]};const sim=p24kSimulateDrop(1,0,0,[],[K_DOMINO_H('x','s1','c1')],level,false);return !sim.legal&&sim.reason==='blocked';})();
  checks.sealed_cell_blocks_until_open=(()=>{const level={size:4,seals:[[1,1]]};const closed=p24kSimulateDrop(1,0,0,[],[K_DOMINO_H('x','s1','c1')],level,false);const open=p24kSimulateDrop(1,0,0,[],[K_DOMINO_H('x','s1','c1')],level,true);return !closed.legal&&closed.reason==='blocked'&&open.legal;})();
  checks.every_seal_level_opens_in_its_own_solution=P24M_LEVELS.every((level,i)=>!level.seals||!level.seals.length||p24kRunSolution(i).model.sealOpen===true);
  checks.every_target_face_level_has_valid_required_count=P24M_LEVELS.every(level=>!level.targetRequiredCount||(level.winTargets&&level.targetRequiredCount<=level.winTargets.length));
  checks.all_solutions=P24M_LEVELS.every((_l,i)=>p24kRunSolution(i).ok);
  return {ok:Object.values(checks).every(Boolean),checks};
}

delete window.__digest24k;
window.__digest24k1={S,LEVELS:P24M_LEVELS,MODEL:P24K,startLevel,reset:()=>startLevel(S.lv),simulateDrop:p24kSimulateDrop,place:p24kPlace,legalMoves:p24kLegalMoves,firstLegalMove:p24kFirstLegalMove,selfTest:p24mSelfTest,runSolution:p24kRunSolution,debug:{isExposed:p24mIsExposed,topAt:p24mTopAt,findWavePairs:p24kFindWavePairs,resolveAll:p24kResolveAllModel,modelDrop:p24kModelDrop,freshModel:p24kFreshModel},state:()=>({level:S.lv,busy:S.busy,phase:P24K.phase,moves:S.placed,pairs:S.pairs,score:S.score,goal:{pairGoal:p24kLevel().pairGoal,current:S.pairs},queueIndex:P24K.queueIndex,current:p24kClonePiece(P24K.pieces[0]),next:p24kClonePiece(P24K.pieces[1]),cells:P24K.tiles.filter(t=>t.alive).map(t=>({uid:t.uid,id:t.id,r:t.r,c:t.c,z:t.z,covered:t.z===0&&!!p24kTileAt(t.r,t.c,1),matchEligible:p24mIsExposed(t)})),lastTurn:P24K.lastTurn?JSON.parse(JSON.stringify(P24K.lastTurn)):null})};
const p24mTest=p24mSelfTest();console.log('[24K-1 selftest]',p24mTest.ok?'OK':'FAIL',p24mTest.checks);startLevel(typeof p24kLevelFromURL==='function'?p24kLevelFromURL():0);

})();



window.__LAYER_PROTOTYPE__={"id":"24K-1","title":"Top Match · 10 level"};

})();
</script>
<script>
/* Các module prototype cũ hơn được ghép trong file này (24K, 24K V2) mỗi
   module đều tự gọi startLevel(0) khi nạp trang, và các bản cũ đó vẫn còn
   gọi overlay() để hiện thẻ giới thiệu màn — để lại đúng #ov/#ovcard dùng
   chung thì module chạy sau cùng mới không bị lỗi thiếu phần tử, nhưng hệ
   quả là lớp overlay bị bật '.on' và mắc kẹt che luôn màn hình chính, dù
   module thật sự đang chạy (P24M ở cuối file) không dùng overlay() nữa.
   Dọn lại đúng 1 lần sau khi mọi script ở trên đã chạy xong, trước khi
   trình duyệt vẽ khung hình đầu tiên. */
(function(){ const ov=document.getElementById('ov'); if(ov) ov.classList.remove('on'); })();
</script>
</body>
