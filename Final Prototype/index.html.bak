    </g>
  </g>

  <g class="zb-bamboo right" transform="translate(378,450) scale(-1,1)">
    <rect x="0" y="0" width="10" height="350" rx="5" fill="#4d5a24" opacity=".68"/>
    <rect x="18" y="50" width="9" height="300" rx="4.5" fill="#7c8a3e" opacity=".6"/>
    <g fill="#0d241d" opacity=".4">
      <rect x="0" y="30" width="10" height="4"/><rect x="0" y="100" width="10" height="4"/><rect x="0" y="170" width="10" height="4"/>
    </g>
    <g class="zb-leaves" fill="#8fbf52" opacity=".6">
      <path d="M4,6 Q-16,-4 -30,4 Q-14,10 4,6Z"/>
      <path d="M18,0 Q4,-18 12,-32 Q26,-16 18,0Z"/>
    </g>
