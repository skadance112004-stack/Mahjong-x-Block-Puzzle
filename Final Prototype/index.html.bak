<svg viewBox="0 0 400 800" preserveAspectRatio="xMidYMax slice" xmlns="http://www.w3.org/2000/svg">
  <path d="M0,260 Q60,200 130,240 T260,220 T400,250 L400,340 L0,340 Z" fill="#4a3220" opacity=".22"/>
  <path d="M0,300 Q90,250 180,290 T400,280 L400,360 L0,360 Z" fill="#2e2018" opacity=".28"/>

  <g style="transform:translate(70px,110px)"><path class="bird-a" d="M0,0 Q6,-7 12,0 Q18,-7 24,0" fill="none" stroke="#e8b64c" stroke-width="2" stroke-linecap="round" opacity=".55"/></g>
  <g style="transform:translate(250px,70px)"><path class="bird-b" d="M0,0 Q5,-6 10,0 Q15,-6 20,0" fill="none" stroke="#e8b64c" stroke-width="2" stroke-linecap="round" opacity=".45"/></g>
  <g style="transform:translate(310px,170px)"><path class="bird-c" d="M0,0 Q4,-5 8,0 Q12,-5 16,0" fill="none" stroke="#e8b64c" stroke-width="1.6" stroke-linecap="round" opacity=".4"/></g>

  <g class="zb-bamboo left" transform="translate(4,420)">
    <rect x="0" y="0" width="10" height="380" rx="5" fill="#4d5a24" opacity=".68"/>
    <rect x="18" y="60" width="9" height="320" rx="4.5" fill="#7c8a3e" opacity=".6"/>
    <rect x="34" y="120" width="8" height="260" rx="4" fill="#a7b85a" opacity=".5"/>
    <g fill="#0d241d" opacity=".4">
      <rect x="0" y="40" width="10" height="4"/><rect x="0" y="110" width="10" height="4"/><rect x="0" y="180" width="10" height="4"/>
      <rect x="18" y="100" width="9" height="4"/><rect x="18" y="170" width="9" height="4"/>
    </g>
    <g class="zb-leaves" fill="#8fbf52" opacity=".6">
      <path d="M4,10 Q-16,0 -30,8 Q-14,14 4,10Z"/>
      <path d="M4,20 Q26,8 40,18 Q22,26 4,20Z"/>
